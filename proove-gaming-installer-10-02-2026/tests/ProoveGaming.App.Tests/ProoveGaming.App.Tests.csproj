<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProoveGaming.App\ProoveGaming.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real resource files and the real device catalog, copied into the test output rather
         than reached by walking up the source tree: the test then passes wherever the assembly is
         run from, and fails with a clear message if a copy is ever dropped. Same technique as
         StarlightCatalogTests. -->
    <None Include="..\..\src\ProoveGaming.App\Resources\Strings.en.axaml" Link="Strings.en.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Resources\Strings.uk.axaml" Link="Strings.uk.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.DeviceHost\appsettings.json" Link="appsettings.DeviceHost.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\appsettings.json" Link="appsettings.App.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Converters\DeviceTypeLabelConverter.cs" Link="DeviceTypeLabelConverter.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\DeviceDetails\Sections\MacrosSectionView.axaml" Link="MacrosSectionView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The key-overlay code-behind decides the hover tip's unassign (✕) visibility imperatively,
         and there is no Avalonia headless harness here — so it is pinned by reading the source,
         linked as .txt so the test project does not try to COMPILE it (same as the converter
         above). See DeviceDetailsExtendedKeysViewModelTests.HoverTip_WithholdsTheUnassignCross_*. -->
    <None Include="..\..\src\ProoveGaming.App\Views\DeviceDetails\Sections\RasterKeyboardOverlayView.axaml.cs" Link="RasterKeyboardOverlayView.axaml.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\SingleCard.axaml" Link="SingleCard.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\DoubleCard.axaml" Link="DoubleCard.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\CardStatusRowView.axaml" Link="CardStatusRowView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\InformationView.axaml" Link="InformationView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\Information\PrivacyPolicyEnView.axaml" Link="PrivacyPolicyEnView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\Information\PrivacyPolicyUkView.axaml" Link="PrivacyPolicyUkView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\Information\TermsOfServiceEnView.axaml" Link="TermsOfServiceEnView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\Information\TermsOfServiceUkView.axaml" Link="TermsOfServiceUkView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\Information\LicenseAgreementEnView.axaml" Link="LicenseAgreementEnView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\Information\LicenseAgreementUkView.axaml" Link="LicenseAgreementUkView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.App\Views\WelcomeView.axaml" Link="WelcomeView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.Installer\Views\AgreementTermsEnView.axaml" Link="AgreementTermsEnView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ProoveGaming.Installer\Views\AgreementTermsUkView.axaml" Link="AgreementTermsUkView.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
