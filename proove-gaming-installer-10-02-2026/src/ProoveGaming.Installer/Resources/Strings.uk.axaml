<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=System.Runtime">
	<sys:String x:Key="Window_Title">Встановлення Proove Gaming</sys:String>
	<sys:String x:Key="Header_Title">Інсталятор Proove Gaming</sys:String>
	<sys:String x:Key="Header_Subtitle">Використайте цей інсталятор, щоб запустити MSI-встановлення Proove Gaming.</sys:String>
	<sys:String x:Key="Step0_Header_Title">Ласкаво просимо</sys:String>
	<sys:String x:Key="Step0_Header_Subtitle">Підготовка інсталятора...</sys:String>
	<sys:String x:Key="Step1_Header_Title">Ласкаво просимо</sys:String>
	<sys:String x:Key="Step1_Header_Subtitle">Ласкаво просимо до майстра встановлення Proove Gaming.</sys:String>
	<sys:String x:Key="Welcome_Title_Design">Ласкаво просимо</sys:String>
	<sys:String x:Key="Step2_Header_Title">Політика конфіденційності клієнта</sys:String>
	<sys:String x:Key="Step2_Header_Subtitle">Ознайомтеся з угодою та прийміть її, щоб продовжити.</sys:String>
	<sys:String x:Key="Step3_Header_Title">Папка встановлення</sys:String>
	<sys:String x:Key="Step3_Header_Description">Виберіть місце встановлення або продовжіть із типовим шляхом</sys:String>
	<sys:String x:Key="Step3_Header_Subtitle">Оберіть місце встановлення Proove Gaming.</sys:String>
	<sys:String x:Key="Step4_Header_Title">Встановлення</sys:String>
	<sys:String x:Key="Step4_Header_Subtitle">Зачекайте, поки майстер встановить Proove Gaming.</sys:String>
	<sys:String x:Key="Step5_Header_Title">Встановлення завершено</sys:String>
	<sys:String x:Key="Step5_Header_Subtitle">Proove Gaming успішно встановлено.</sys:String>

	<sys:String x:Key="Welcome_Message">Ласкаво просимо до програми встановлення Proove Gaming!
	Оберіть бажану мову</sys:String>
	<sys:String x:Key="Installing_Message">Встановлення файлів і налаштування інтеграції з системою...</sys:String>
	<sys:String x:Key="Complete_Message_Prefix">Натисніть</sys:String>
	<sys:String x:Key="Complete_Message_Action">Завершити</sys:String>
	<sys:String x:Key="Complete_Message_Suffix">, щоб вийти з інсталятора</sys:String>
	<sys:String x:Key="Uninstall_Title">Видалити Proove Gaming</sys:String>
	<sys:String x:Key="Uninstall_Message">Бажаєте видалити Proove Gaming з цього пристрою?</sys:String>
	<sys:String x:Key="Agreement_Text">ЛІЦЕНЗІЙНА УГОДА КІНЦЕВОГО КОРИСТУВАЧА\n\nПродовжуючи, ви погоджуєтесь встановити Proove Gaming та використовувати його відповідно до умов вашої організації.\n\nЦей текст є тимчасовим і має бути замінений на юридично затверджену угоду.</sys:String>
	<sys:String x:Key="Agreement_Checkbox">Я приймаю умови ліцензійної угоди</sys:String>
	<sys:String x:Key="Folder_BrowseTitle">Виберіть папку встановлення</sys:String>

	<sys:String x:Key="Label_LaunchAfterInstall">Запустити PROOVE GAMING</sys:String>
	<sys:String x:Key="Label_CreateDesktopShortcut">Створити ярлик на робочому столі</sys:String>
	<sys:String x:Key="Label_CreateStartMenuShortcut">Створити ярлик у меню «Пуск»</sys:String>
	<sys:String x:Key="Button_Back">НАЗАД</sys:String>
	<sys:String x:Key="Button_Next">ДАЛІ</sys:String>
	<sys:String x:Key="Button_AgreeAndContinue">ПОГОДЖУЮСЯ ТА ПРОДОВЖИТИ</sys:String>
	<sys:String x:Key="Button_Install">ВСТАНОВИТИ</sys:String>
	<sys:String x:Key="Button_Browse">ОГЛЯД</sys:String>
	<sys:String x:Key="Button_Finish">ЗАВЕРШИТИ</sys:String>
	<sys:String x:Key="Button_Cancel">СКАСУВАТИ</sys:String>
	<sys:String x:Key="Button_Uninstall">ВИДАЛИТИ</sys:String>
	<sys:String x:Key="ModalCancel_Title">Скасувати встановлення?</sys:String>
	<sys:String x:Key="ModalCancel_Subtitle">Встановлення буде зупинено, а прогрес — втрачено.</sys:String>
	<sys:String x:Key="ModalCancel_PrimaryButton">СКАСУВАТИ</sys:String>
	<sys:String x:Key="ModalCancel_SecondaryButton">ПРОДОВЖИТИ ВСТАНОВЛЕННЯ</sys:String>
	<sys:String x:Key="Message_InfoTitle">Інформація</sys:String>
	<sys:String x:Key="Message_ErrorTitle">Помилка</sys:String>
	<sys:String x:Key="Status_Installing">Встановлення Proove Gaming...</sys:String>
	<sys:String x:Key="Status_CopyingFiles">Копіювання файлів програми...</sys:String>
	<sys:String x:Key="Status_ClosingApp">Закриття застосунку Proove Gaming...</sys:String>
	<sys:String x:Key="Status_StoppingDeviceHostService">Зупинення служби Device Host...</sys:String>
	<sys:String x:Key="Status_CancellingInstall">Скасування встановлення та видалення файлів...</sys:String>
	<sys:String x:Key="Message_ServiceConfigureFailed">Не вдалося налаштувати службу Windows Device Host (код помилки {0}). Закрийте застосунок Proove Gaming і спробуйте ще раз.</sys:String>
	<sys:String x:Key="Status_ConfiguringDeviceHostService">Налаштування служби Windows Device Host...</sys:String>
	<sys:String x:Key="Message_AgreementRequired">Щоб продовжити, потрібно прийняти угоду.</sys:String>
	<sys:String x:Key="Message_InvalidInstallPath">Будь ласка, вкажіть коректну папку встановлення.</sys:String>
	<sys:String x:Key="Message_InvalidInstallPathChars">У шляху не можна використовувати символи: &lt; &gt; " | ? *</sys:String>
	<sys:String x:Key="Message_InstallPathNotAllowed">Виберіть для Proove Gaming окрему папку, а не диск чи системну або користувацьку папку.</sys:String>
	<sys:String x:Key="Message_InstallFolderNotEmpty">Ця папка вже містить інші файли. Виберіть порожню або нову папку.</sys:String>
	<sys:String x:Key="Message_InstallFolderUnsafe">Цю папку не можна безпечно використати: вона містить посилання на інше розташування або її змінено під час встановлення. Виберіть нову папку.</sys:String>
	<sys:String x:Key="Message_PayloadNotFound">Інсталяційний пакет не знайдено. Перезберіть інсталятор із вбудованим payload.</sys:String>
	<sys:String x:Key="Message_AccessDenied">Немає доступу для встановлення файлів. Спробуйте запустити інсталятор від імені адміністратора.</sys:String>
	<sys:String x:Key="Message_InstallFailedDetails">Встановлення завершилося помилкою: {0}</sys:String>
	<sys:String x:Key="Message_UninstallFailed">Не вдалося завершити видалення.</sys:String>
	<sys:String x:Key="Message_AppNotFound">Встановлення завершено, але виконуваний файл програми не знайдено: {0}</sys:String>
	<sys:String x:Key="Message_InsufficientDiskSpace">Недостатньо місця на диску для встановлення. Потрібно: {0}. Доступно: {1}.</sys:String>
</ResourceDictionary>
