<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=System.Runtime">
	<sys:String x:Key="Window_Title">Proove Gaming Setup</sys:String>
	<sys:String x:Key="Header_Title">Proove Gaming Installer</sys:String>
	<sys:String x:Key="Header_Subtitle">Use this installer to start MSI setup for Proove Gaming.</sys:String>
	<sys:String x:Key="Step0_Header_Title">Welcome</sys:String>
	<sys:String x:Key="Step0_Header_Subtitle">Preparing installer experience...</sys:String>
	<sys:String x:Key="Step1_Header_Title">Welcome</sys:String>
	<sys:String x:Key="Step1_Header_Subtitle">Welcome to Proove Gaming setup wizard.</sys:String>
	<sys:String x:Key="Welcome_Title_Design">Welcome</sys:String>
	<sys:String x:Key="Step2_Header_Title">Customer Privacy Policy</sys:String>
	<sys:String x:Key="Step2_Header_Subtitle">Please review and accept the agreement to continue.</sys:String>
	<sys:String x:Key="Step3_Header_Title">Installation Folder</sys:String>
	<sys:String x:Key="Step3_Header_Description">Select your installation location or proceed with the default path</sys:String>
	<sys:String x:Key="Step3_Header_Subtitle">Select where Proove Gaming will be installed.</sys:String>
	<sys:String x:Key="Step4_Header_Title">Installing</sys:String>
	<sys:String x:Key="Step4_Header_Subtitle">Please wait while setup installs Proove Gaming.</sys:String>
	<sys:String x:Key="Step5_Header_Title">Installation Complete</sys:String>
	<sys:String x:Key="Step5_Header_Subtitle">Proove Gaming has been installed successfully.</sys:String>

	<sys:String x:Key="Welcome_Message">Welcome to the Proove Gaming installation program!
	Select your preferred language</sys:String>
	<sys:String x:Key="Installing_Message">Installing files and configuring system integration...</sys:String>
	<sys:String x:Key="Complete_Message_Prefix">Click</sys:String>
	<sys:String x:Key="Complete_Message_Action">Finish</sys:String>
	<sys:String x:Key="Complete_Message_Suffix">to exit the installer</sys:String>
	<sys:String x:Key="Uninstall_Title">Remove Proove Gaming</sys:String>
	<sys:String x:Key="Uninstall_Message">Do you want to uninstall Proove Gaming from this device?</sys:String>
	<sys:String x:Key="Agreement_Text">END USER LICENSE AGREEMENT\n\nBy continuing, you agree to install Proove Gaming and use it according to your organization's terms and conditions.\n\nThis placeholder text should be replaced with your legal agreement content.</sys:String>
	<sys:String x:Key="Agreement_Checkbox">I accept the terms of the license agreement</sys:String>
	<sys:String x:Key="Folder_BrowseTitle">Select installation folder</sys:String>

	<sys:String x:Key="Label_LaunchAfterInstall">Launch PROOVE GAMING</sys:String>
	<sys:String x:Key="Label_CreateDesktopShortcut">Create Desktop shortcut</sys:String>
	<sys:String x:Key="Label_CreateStartMenuShortcut">Create Start Menu shortcut</sys:String>
	<sys:String x:Key="Button_Back">BACK</sys:String>
	<sys:String x:Key="Button_Next">NEXT</sys:String>
	<sys:String x:Key="Button_AgreeAndContinue">AGREE AND CONTINUE</sys:String>
	<sys:String x:Key="Button_Install">INSTALL</sys:String>
	<sys:String x:Key="Button_Browse">BROWSE</sys:String>
	<sys:String x:Key="Button_Finish">FINISH</sys:String>
	<sys:String x:Key="Button_Cancel">CANCEL</sys:String>
	<sys:String x:Key="Button_Uninstall">UNINSTALL</sys:String>
	<sys:String x:Key="ModalCancel_Title">Cancel installation?</sys:String>
	<sys:String x:Key="ModalCancel_Subtitle">Installing will be stopped and progress will be lost.</sys:String>
	<sys:String x:Key="ModalCancel_PrimaryButton">CANCEL INSTALLATION</sys:String>
	<sys:String x:Key="ModalCancel_SecondaryButton">CONTINUE INSTALLATION</sys:String>
	<sys:String x:Key="Message_InfoTitle">Info</sys:String>
	<sys:String x:Key="Message_ErrorTitle">Error</sys:String>
	<sys:String x:Key="Status_Installing">Installing Proove Gaming...</sys:String>
	<sys:String x:Key="Status_CopyingFiles">Copying application files...</sys:String>
	<sys:String x:Key="Status_ClosingApp">Closing the Proove Gaming app...</sys:String>
	<sys:String x:Key="Status_StoppingDeviceHostService">Stopping the Device Host service...</sys:String>
	<sys:String x:Key="Status_CancellingInstall">Cancelling installation and removing files...</sys:String>
	<sys:String x:Key="Message_ServiceConfigureFailed">Failed to configure the Device Host Windows service (error code {0}). Close the Proove Gaming app and try again.</sys:String>
	<sys:String x:Key="Status_ConfiguringDeviceHostService">Configuring Device Host Windows service...</sys:String>
	<sys:String x:Key="Message_AgreementRequired">You need to accept the agreement before continuing.</sys:String>
	<sys:String x:Key="Message_InvalidInstallPath">Please specify a valid installation folder.</sys:String>
	<sys:String x:Key="Message_InvalidInstallPathChars">You can't use these characters in the path: &lt; &gt; " | ? *</sys:String>
	<sys:String x:Key="Message_InstallPathNotAllowed">Choose a folder of its own for Proove Gaming, not a drive or a system or user folder.</sys:String>
	<sys:String x:Key="Message_InstallFolderNotEmpty">This folder already contains other files. Choose an empty folder or a new one.</sys:String>
	<sys:String x:Key="Message_InstallFolderUnsafe">This folder cannot be used safely: it contains a link to another location, or something else changed it during the installation. Choose a new folder.</sys:String>
	<sys:String x:Key="Message_PayloadNotFound">Installer payload was not found. Rebuild installer with embedded payload.</sys:String>
	<sys:String x:Key="Message_AccessDenied">Access denied while installing files. Try running installer as Administrator.</sys:String>
	<sys:String x:Key="Message_InstallFailedDetails">Installation failed: {0}</sys:String>
	<sys:String x:Key="Message_UninstallFailed">Uninstall could not be completed.</sys:String>
	<sys:String x:Key="Message_AppNotFound">Installation completed, but app executable was not found: {0}</sys:String>
	<sys:String x:Key="Message_InsufficientDiskSpace">Not enough disk space for installation. Required: {0}. Available: {1}.</sys:String>
</ResourceDictionary>
