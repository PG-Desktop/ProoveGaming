<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:commonLayouts="clr-namespace:ProoveGaming.Common.Layouts;assembly=ProoveGaming.Common"
			 xmlns:views="using:ProoveGaming.Installer.Views"
			 x:Class="ProoveGaming.Installer.Views.CompleteStepView">
	<commonLayouts:StepFrameLayoutView>
		<commonLayouts:StepFrameLayoutView.StepContent>
			<Border VerticalAlignment="Center"
					Padding="0"
					Margin="0">
				<Grid Width="600"
					  HorizontalAlignment="Center"
					  RowDefinitions="Auto,*,Auto"
					  RowSpacing="18">
					<StackPanel Grid.Row="0"
								Width="600"
								Spacing="8"
								HorizontalAlignment="Center">
						<TextBlock Text="{DynamicResource Step5_Header_Title}"
								   Classes="installerStepTitle"
								   Foreground="White"
								   HorizontalAlignment="Center"
								   TextAlignment="Center" />
						<TextBlock FontFamily="{DynamicResource BaseAppFont}"
								   FontWeight="Normal"
								   FontStyle="Normal"
								   FontSize="16"
								   LineHeight="24"
								   HorizontalAlignment="Center"
								   TextAlignment="Center">
							<Run Text="{DynamicResource Complete_Message_Prefix}" Foreground="#B3BEBCEA" />
							<Run Text="{DynamicResource Complete_Message_Action}" FontWeight="Bold" Foreground="#FFFFFFFF" />
							<Run Text="{DynamicResource Complete_Message_Suffix}" Foreground="#B3BEBCEA" />
						</TextBlock>
					</StackPanel>

					<Border Grid.Row="1"
							HorizontalAlignment="Center"
							Background="Transparent"
							Padding="0">
						<StackPanel Spacing="14">
							<CheckBox x:Name="FinishLaunchAppCheckBox"
									  Classes="pgCheckbox pgOptionCheckBox installerOptionCheckBox"
									  IsChecked="True"
									  HorizontalAlignment="Center"
									  Content="{DynamicResource Label_LaunchAfterInstall}" />
						</StackPanel>
					</Border>

					<Grid Grid.Row="2"
						  Margin="0,10,0,0"
						  Width="600"
						  HorizontalAlignment="Center"
						  ColumnDefinitions="*">
						<Button x:Name="CompleteFinishButton"
								Grid.Column="0"
								Content="{DynamicResource Button_Finish}"
								Foreground="White"
								HorizontalAlignment="Center"
								Height="56"
								Classes="installerPrimaryButton" />
					</Grid>
				</Grid>
			</Border>
		</commonLayouts:StepFrameLayoutView.StepContent>
	</commonLayouts:StepFrameLayoutView>
</UserControl>
