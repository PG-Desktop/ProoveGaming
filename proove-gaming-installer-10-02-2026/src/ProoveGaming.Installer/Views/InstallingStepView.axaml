<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:views="using:ProoveGaming.Installer.Views"
			 xmlns:commonLayouts="clr-namespace:ProoveGaming.Common.Layouts;assembly=ProoveGaming.Common"
			 xmlns:common="clr-namespace:ProoveGaming.Common.Controls;assembly=ProoveGaming.Common"
			 x:Class="ProoveGaming.Installer.Views.InstallingStepView">
	<commonLayouts:StepFrameLayoutView>
		<commonLayouts:StepFrameLayoutView.StepContent>
			<Border VerticalAlignment="Center"
					Padding="0,100,0,0"
					Margin="0">
				<Grid Width="600"
					  HorizontalAlignment="Center"
					  RowDefinitions="Auto,*,Auto"
					  RowSpacing="18">
					<StackPanel Grid.Row="0"
								Width="600"
								Spacing="8"
								HorizontalAlignment="Center">
						<TextBlock Text="{DynamicResource Step4_Header_Title}"
								   Classes="installerStepTitle"
								   Foreground="White"
								   HorizontalAlignment="Center"
								   TextAlignment="Center" />
						<TextBlock x:Name="StatusText"
								   Text="{DynamicResource Status_Installing}"
								   Classes="installerStepSubtitle" />
					</StackPanel>

					<Border Grid.Row="1"
							HorizontalAlignment="Center"
							BorderBrush="#6357FF"
							BorderThickness="0"
							Background="#14000000"
							Padding="24">
						<common:ProgressWithPercentageView x:Name="InstallProgressView"
														   HorizontalAlignment="Center" />
					</Border>

					<Grid Grid.Row="2"
						  Margin="0,32,0,0"
						  Width="600"
						  HorizontalAlignment="Center"
						  ColumnDefinitions="*"
						  ColumnSpacing="16">
						<Button x:Name="InstallingCancelButton"
								Classes="pgLinkButton"
								Grid.Column="0"
								HorizontalAlignment="Center"
								FontFamily="{DynamicResource InstallerPixelFont}">
							<TextBlock Text="{DynamicResource Button_Cancel}"
									   FontFamily="{DynamicResource InstallerPixelFont}"
									   FontSize="18"
									   Foreground="#6357FF" />
						</Button>
					</Grid>
				</Grid>
			</Border>
		</commonLayouts:StepFrameLayoutView.StepContent>
	</commonLayouts:StepFrameLayoutView>
</UserControl>
