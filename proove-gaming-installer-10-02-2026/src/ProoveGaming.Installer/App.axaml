<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="ProoveGaming.Installer.App">
	<Application.Resources>
		<ResourceDictionary>
			<FontFamily x:Key="BaseAppFont">Segoe UI, Inter</FontFamily>
			<FontFamily x:Key="InstallerPixelFont">avares://ProoveGaming.Common/Assets/Fonts#Pixel Font7, Inter</FontFamily>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://ProoveGaming.Installer/Resources/Strings.en.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
	<Application.Styles>
		<FluentTheme/>
		<StyleInclude Source="avares://ProoveGaming.Common/Styles/SharedCheckboxStyles.axaml"/>
		<StyleInclude Source="avares://ProoveGaming.Common/Styles/SharedActionButtonStyles.axaml"/>
		<StyleInclude Source="avares://ProoveGaming.Common/Styles/SharedLegalDocumentStyles.axaml"/>
		<Style Selector="TextBlock">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="LineHeight" Value="24" />
		</Style>
		<Style Selector="Button">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
		</Style>
		<Style Selector="TextBox">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
		</Style>
		<Style Selector="CheckBox">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
		</Style>
		<Style Selector="Button.installerPrimaryButton">
			<Setter Property="Background" Value="#6357FF" />
			<Setter Property="Foreground" Value="#FFFFFF" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="FontFamily" Value="{DynamicResource InstallerPixelFont}" />
			<Setter Property="FontWeight" Value="Light" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="BorderBrush" Value="#6357FF" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Width" Value="292" />
			<Setter Property="Height" Value="56" />
			<Setter Property="Padding" Value="0,2,0,0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.installerPrimaryButton:pointerover">
			<Setter Property="Background" Value="#786DFF" />
			<Setter Property="BorderBrush" Value="#786DFF" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.installerPrimaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#786DFF" />
			<Setter Property="BorderBrush" Value="#786DFF" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.installerPrimaryButton:disabled">
			<Setter Property="Background" Value="#6357FF" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Opacity" Value="0.1" />
		</Style>
		<Style Selector="Button.installerPrimaryButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#6357FF" />
			<Setter Property="Foreground" Value="White" />
		</Style>

		<Style Selector="Button.installerSecondaryButton">
			<Setter Property="Background" Value="#110F32" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="FontFamily" Value="{DynamicResource InstallerPixelFont}" />
			<Setter Property="FontWeight" Value="Light" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="BorderBrush" Value="#6357FF" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Width" Value="NaN" />
			<Setter Property="Height" Value="56" />
			<Setter Property="Padding" Value="0,4,0,0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.installerSecondaryButton:pointerover">
			<Setter Property="Background" Value="#2A2660" />
			<Setter Property="BorderBrush" Value="#6357FF" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.installerSecondaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#2A2660" />
			<Setter Property="BorderBrush" Value="#6357FF" />
			<Setter Property="Foreground" Value="White" />
		</Style>

		<Style Selector="TextBlock.installerStepTitle">
			<Setter Property="FontFamily" Value="{DynamicResource InstallerPixelFont}" />
			<Setter Property="FontSize" Value="36" />
			<Setter Property="FontWeight" Value="ExtraLight" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="LineHeight" Value="36" />
			<Setter Property="LetterSpacing" Value="0" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.installerStepSubtitle">
			<Setter Property="Foreground" Value="#BEBCEA" />
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="LineHeight" Value="24" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.agreementTermsRoot">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="LineHeight" Value="24" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Run.agreementTitleText">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="Foreground" Value="#FFFFFF" />
		</Style>
		<!-- Document title line — one step above the 18px section headings, mirroring the
		     App's legalDocTitle so the agreement text hierarchy matches on both surfaces. -->
		<Style Selector="Run.agreementDocTitleText">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="Foreground" Value="#FFFFFF" />
		</Style>
		<Style Selector="Run.agreementRegularText">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="Foreground" Value="#B3BEBCEA" />
		</Style>
		<Style Selector="Run.agreementBoldText">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="Foreground" Value="#FFFFFF" />
		</Style>

		<Style Selector="CheckBox.installerOptionCheckBox /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="#B3BEBCEA" />
		</Style>
		<Style Selector="CheckBox.installerOptionCheckBox:checked">
			<Setter Property="Foreground" Value="#B3BEBCEA" />
		</Style>
		<Style Selector="CheckBox.installerOptionCheckBox:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="#B3BEBCEA" />
		</Style>
		<Style Selector="CheckBox.installerOptionCheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="#B3BEBCEA" />
		</Style>
	</Application.Styles>
</Application>

