<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="using:ProoveGaming.App.Controls"
			 xmlns:converters="using:ProoveGaming.App.Converters"
			 x:Class="ProoveGaming.App.Controls.PercentSliderControl"
			 Height="32"
			 ClipToBounds="False"
			 Cursor="Hand">
	<!-- The section-slider visual used across device-details pages: flat track, filled span and a
		 tall thumb, all driven by a 0..100 Percent. Pointer handling lives in the code-behind and
		 surfaces as FractionChanged (0..1 of the track) — the consumer converts to its own units.
		 Bindings are RelativeSource-to-self so the control leaves the inherited DataContext alone
		 for the Percent binding at the call site. -->
	<Grid>
		<Rectangle Fill="#49475E" Height="9" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
		<Rectangle Fill="#6357FF" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left">
			<Rectangle.Width>
				<MultiBinding Converter="{x:Static converters:PercentageWidthConverter.Instance}">
					<Binding Path="Percent" RelativeSource="{RelativeSource AncestorType=controls:PercentSliderControl}" />
					<Binding Path="Bounds.Width" RelativeSource="{RelativeSource AncestorType=controls:PercentSliderControl}" />
				</MultiBinding>
			</Rectangle.Width>
		</Rectangle>
		<Rectangle Fill="#6357FF" Width="9" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left">
			<Rectangle.Margin>
				<MultiBinding Converter="{x:Static converters:PercentageThumbMarginConverter.Instance}">
					<Binding Path="Percent" RelativeSource="{RelativeSource AncestorType=controls:PercentSliderControl}" />
					<Binding Path="Bounds.Width" RelativeSource="{RelativeSource AncestorType=controls:PercentSliderControl}" />
				</MultiBinding>
			</Rectangle.Margin>
		</Rectangle>
	</Grid>
</UserControl>
