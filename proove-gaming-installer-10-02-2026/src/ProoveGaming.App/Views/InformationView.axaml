<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1392" d:DesignHeight="844"
             x:Class="ProoveGaming.App.Views.InformationView">

    <UserControl.Styles>
        <!-- Tab label spec: Segoe UI Regular 12/16, white, centered. The uppercase
             comes from the resource strings themselves (Avalonia has no text-transform). -->
        <Style Selector="TextBlock.informationTabLabel">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="LetterSpacing" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="80,*">

        <!-- ══ Header ══ -->
        <Grid Grid.Row="0" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="16">
                <Button x:Name="NavBackButton"
                        Classes="linkButton"
                        Cursor="Hand">
                    <Grid Width="56" Height="56">
                        <Path x:Name="NavBackBg"
                              Fill="#4D6357FF"
                              Data="{StaticResource CutCornerFrameGeometry}"/>
                        <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M5.1 12L12.5667 19.4667L10.6667 21.3333L0 10.6667L10.6667 0L12.5667 1.86667L5.1 9.33333H21.3333V12H5.1Z"/>
                    </Grid>
                </Button>
                <TextBlock Text="{DynamicResource InformationView_Title}"
                           FontFamily="{DynamicResource AppPixelFont}"
                           FontSize="36"
                           LineHeight="32"
                           FontWeight="250"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══ Octagon + Sidebar Frame (ProfileView's tab-panel pattern, extended to three
             zones: 16px outer insets, 64px highlight zones, 4px gaps → 232px tall) ══ -->
        <Grid Grid.Row="1" ColumnDefinitions="200,4,42,668,42"
              HorizontalAlignment="Center" VerticalAlignment="Stretch"
              UseLayoutRounding="False"
              Margin="0,12,0,0">

            <Canvas Grid.Column="0" Width="200" Height="232" VerticalAlignment="Top">

                <!-- Octagonal background -->
                <Path Fill="#CC000000"
                      Data="M20,0 L180,0 L200,20 L200,212 L180,232 L20,232 L0,212 L0,20 Z"/>

                <!-- PRIVACY POLICY highlight (zone y 16..80) -->
                <Canvas x:Name="PrivacyPolicyHighlight">
                    <Rectangle Canvas.Left="28" Canvas.Top="16" Width="144" Height="8" Fill="#336357FF"/>
                    <Rectangle Canvas.Left="20" Canvas.Top="24" Width="160" Height="48" Fill="#336357FF"/>
                    <Rectangle Canvas.Left="28" Canvas.Top="72" Width="144" Height="8" Fill="#336357FF"/>
                </Canvas>

                <!-- TERMS OF SERVICE highlight (zone y 84..148) -->
                <Canvas x:Name="TermsOfServiceHighlight" IsVisible="False">
                    <Rectangle Canvas.Left="28" Canvas.Top="84" Width="144" Height="8" Fill="#336357FF"/>
                    <Rectangle Canvas.Left="20" Canvas.Top="92" Width="160" Height="48" Fill="#336357FF"/>
                    <Rectangle Canvas.Left="28" Canvas.Top="140" Width="144" Height="8" Fill="#336357FF"/>
                </Canvas>

                <!-- LICENSE AGREEMENT highlight (zone y 152..216) -->
                <Canvas x:Name="LicenseAgreementHighlight" IsVisible="False">
                    <Rectangle Canvas.Left="28" Canvas.Top="152" Width="144" Height="8" Fill="#336357FF"/>
                    <Rectangle Canvas.Left="20" Canvas.Top="160" Width="160" Height="48" Fill="#336357FF"/>
                    <Rectangle Canvas.Left="28" Canvas.Top="208" Width="144" Height="8" Fill="#336357FF"/>
                </Canvas>

                <!-- Icon + label per tab, group-centered inside the highlight zones (Profile's
                     trick for multi-line uk labels). Icon fills are swapped between the active
                     and inactive brushes in code-behind (UpdateDocument), mirroring Profile's
                     AccountIconBrush/SecurityIconBrush. -->
                <Border Canvas.Left="20" Canvas.Top="16" Width="160" Height="64">
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <Path x:Name="PrivacyPolicyIcon"
                              Width="16" Height="20" Stretch="Uniform"
                              Fill="#6357FF" HorizontalAlignment="Center"
                              Data="M7 15H9V9H7V15ZM8.7125 6.7125C8.90417 6.52083 9 6.28333 9 6C9 5.71667 8.90417 5.47917 8.7125 5.2875C8.52083 5.09583 8.28333 5 8 5C7.71667 5 7.47917 5.09583 7.2875 5.2875C7.09583 5.47917 7 5.71667 7 6C7 6.28333 7.09583 6.52083 7.2875 6.7125C7.47917 6.90417 7.71667 7 8 7C8.28333 7 8.52083 6.90417 8.7125 6.7125ZM8 20C5.68333 19.4167 3.77083 18.0875 2.2625 16.0125C0.754167 13.9375 0 11.6333 0 9.1V3L8 0L16 3V9.1C16 11.6333 15.2458 13.9375 13.7375 16.0125C12.2292 18.0875 10.3167 19.4167 8 20ZM8 17.9C9.73333 17.35 11.1667 16.25 12.3 14.6C13.4333 12.95 14 11.1167 14 9.1V4.375L8 2.125L2 4.375V9.1C2 11.1167 2.56667 12.95 3.7 14.6C4.83333 16.25 6.26667 17.35 8 17.9Z"/>
                        <TextBlock Classes="informationTabLabel"
                                   Text="{DynamicResource InformationView_Tab_PrivacyPolicy}"/>
                    </StackPanel>
                </Border>
                <Border Canvas.Left="20" Canvas.Top="84" Width="160" Height="64">
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <Path x:Name="TermsOfServiceIcon"
                              Width="18" Height="19" Stretch="Uniform"
                              Fill="#80BEBCEA" HorizontalAlignment="Center"
                              Data="M0 19V17H12V19H0ZM5.65 14.15L0 8.5L2.1 6.35L7.8 12L5.65 14.15ZM12 7.8L6.35 2.1L8.5 0L14.15 5.65L12 7.8ZM16.6 18L3.55 4.95L4.95 3.55L18 16.6L16.6 18Z"/>
                        <TextBlock Classes="informationTabLabel"
                                   Text="{DynamicResource InformationView_Tab_TermsOfService}"/>
                    </StackPanel>
                </Border>
                <Border Canvas.Left="20" Canvas.Top="152" Width="160" Height="64">
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <!-- Stand-in in the same Material style (document with text lines) —
                             the designer has not delivered this tab's icon yet; swap the path
                             data when it arrives. -->
                        <Path x:Name="LicenseAgreementIcon"
                              Width="16" Height="20" Stretch="Uniform"
                              Fill="#80BEBCEA" HorizontalAlignment="Center"
                              Data="M8 16H16V18H8V16ZM8 12H16V14H8V12ZM14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.89 22 5.99 22H18C19.1 22 20 21.1 20 20V8L14 2ZM18 20H6V4H13V9H18V20Z"/>
                        <TextBlock Classes="informationTabLabel"
                                   Text="{DynamicResource InformationView_Tab_LicenseAgreement}"/>
                    </StackPanel>
                </Border>

                <!-- Clickable overlays (on top for hit-testing; zone boundaries at the
                     midpoints of the 4px gaps) -->
                <Button Canvas.Left="0" Canvas.Top="0" Width="200" Height="82"
                        Classes="linkButton" Cursor="Hand"
                        Click="OnPrivacyPolicyTabClick"/>
                <Button Canvas.Left="0" Canvas.Top="82" Width="200" Height="68"
                        Classes="linkButton" Cursor="Hand"
                        Click="OnTermsOfServiceTabClick"/>
                <Button Canvas.Left="0" Canvas.Top="150" Width="200" Height="82"
                        Classes="linkButton" Cursor="Hand"
                        Click="OnLicenseAgreementTabClick"/>

            </Canvas>

            <!-- ══ Left Sidebar Frame ══ -->
            <Grid Grid.Column="2" VerticalAlignment="Stretch" RowDefinitions="21.3145,*,21.3145">
                <Canvas Grid.Row="0" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M0 21.3145 L 21.6462 0 L 42 0 L 42 21.3145 Z"/>
                </Canvas>
                <Rectangle Grid.Row="1" Fill="#CC000000"/>
                <Canvas Grid.Row="2" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M0 0 L 21.6462 21.3145 L 42 21.3145 L 42 0 Z"/>
                </Canvas>
            </Grid>

            <!-- ══ Main Content ══ -->
            <Rectangle Grid.Column="3" Fill="#CC000000" VerticalAlignment="Stretch"/>
            <!-- Mock: the bar starts on the same line as the first text row (48 below the
                 panel top), and the text softly fades out at the panel bottom — the
                 gradient opacity mask does the fade; the content's bottom padding lets
                 the document's last line scroll up out of the faded zone. -->
            <ScrollViewer Grid.Column="3"
                          x:Name="DocumentScrollViewer"
                          Classes="pgScrollViewer"
                          AllowAutoHide="False"
                          VerticalScrollBarVisibility="Visible"
                          Margin="0,48,0,24">
                <!-- The bottom fade-out is applied in code-behind (UpdateDocumentFade): a
                     fixed 40px depth on the content presenter, recomputed on resize, so it
                     always stays shallower than the content's 64px bottom padding and never
                     dims the scrollbar (PR #133 review m1). -->
                <ContentControl x:Name="DocumentHost" Margin="24,0,20,64"/>
            </ScrollViewer>

            <!-- ══ Right Sidebar Frame ══ -->
            <Grid Grid.Column="4" VerticalAlignment="Stretch" RowDefinitions="21.3145,*,21.3145">
                <Canvas Grid.Row="0" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M42 21.3145 L 20.3538 0 L 0 0 L 0 21.3145 Z"/>
                </Canvas>
                <Rectangle Grid.Row="1" Fill="#CC000000"/>
                <Canvas Grid.Row="2" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M42 0 L 20.3538 21.3145 L 0 21.3145 L 0 0 Z"/>
                </Canvas>
            </Grid>

        </Grid>

    </Grid>
</UserControl>
