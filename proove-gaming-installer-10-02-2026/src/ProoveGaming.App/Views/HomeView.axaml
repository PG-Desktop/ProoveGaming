2774 30.3892 32.7329 29.2892 32.7329 28.0003C32.7329 26.7114 32.2774 25.6114 31.3663 24.7003C30.4552 23.7892 29.3552 23.3337 28.0663 23.3337C26.7552 23.3337 25.6496 23.7892 24.7496 24.7003C23.8496 25.6114 23.3996 26.7114 23.3996 28.0003C23.3996 29.2892 23.8496 30.3892 24.7496 31.3003C25.6496 32.2114 26.7552 32.667 28.0663 32.667Z"/>
						</Grid>
					</Button>
					<Button x:Name="ProfileButton"
							Background="Transparent" BorderThickness="0" Padding="0"
							Cursor="Hand"
							Click="OnProfileButtonClick"
							IsVisible="{Binding !IsGuest}">
						<Canvas Width="56" Height="56">
							<Path x:Name="ProfileBg"
								  Fill="#6357FF"
								  Data="{StaticResource CutCornerFrameGeometry}"/>
							<Path IsVisible="{Binding HasAvatar}"
								  RenderOptions.BitmapInterpolationMode="HighQuality"
								  Data="{StaticResource CutCornerFrameGeometry}">
								<Path.Fill>
									<ImageBrush Source="{Binding AvatarImage}"
												Stretch="UniformToFill"
												AlignmentX="Center"
												AlignmentY="Center"/>
								</Path.Fill>
							</Path>
							<Path IsVisible="{Binding !HasAvatar}"
								  Fill="White"
								  Data="M20.9 18.2H33.5V19.6H34.9V28H33.5V29.4H23.7V35H20.9V18.2ZM23.7 26.6H32.1V21H23.7V26.6Z"/>
						</Canvas>
					</Button>
					<Button x:Name="GuestButton"
							Click="OnGuestButtonClick"
							Background="Transparent"
							BorderThickness="0"
							Padding="0"
							Cursor="Hand"
							IsVisible="{Binding IsGuest}">
						<Canvas Width="56" Height="56" IsHitTestVisible="False">
							<Path x:Name="GuestBg"
								  Fill="#786DFF"
								  Data="{StaticResource CutCornerFrameGeometry}" />
							<Path Fill="White"
								  Data="M24.234 26.434C23.1895 25.3895 22.6673 24.134 22.6673 22.6673C22.6673 21.2007 23.1895 19.9451 24.234 18.9007C25.2784 17.8562 26.534 17.334 28.0007 17.334C29.4673 17.334 30.7229 17.8562 31.7673 18.9007C32.8118 19.9451 33.334 21.2007 33.334 22.6673C33.334 24.134 32.8118 25.3895 31.7673 26.434C30.7229 27.4784 29.4673 28.0007 28.0007 28.0007C26.534 28.0007 25.2784 27.4784 24.234 26.434ZM17.334 38.6673V34.934C17.334 34.1784 17.5284 33.484 17.9173 32.8507C18.3062 32.2173 18.8229 31.734 19.4673 31.4007C20.8451 30.7118 22.2451 30.1951 23.6673 29.8507C25.0895 29.5062 26.534 29.334 28.0007 29.334C29.4673 29.334 30.9118 29.5062 32.334 29.8507C33.7562 30.1951 35.1562 30.7118 36.534 31.4007C37.1784 31.734 37.6951 32.2173 38.084 32.8507C38.4729 33.484 38.6673 34.1784 38.6673 34.934V38.6673H17.334ZM20.0007 36.0007H36.0007V34.934C36.0007 34.6895 35.9395 34.4673 35.8173 34.2673C35.6951 34.0673 35.534 33.9118 35.334 33.8007C34.134 33.2007 32.9229 32.7507 31.7007 32.4507C30.4784 32.1507 29.2451 32.0007 28.0007 32.0007C26.7562 32.0007 25.5229 32.1507 24.3007 32.4507C23.0784 32.7507 21.8673 33.2007 20.6673 33.8007C20.4673 33.9118 20.3062 34.0673 20.184 34.2673C20.0618 34.4673 20.0007 34.6895 20.0007 34.934V36.0007ZM29.884 24.5507C30.4062 24.0284 30.6673 23.4007 30.6673 22.6673C30.6673 21.934 30.4062 21.3062 29.884 20.784C29.3618 20.2618 28.734 20.0007 28.0007 20.0007C27.2673 20.0007 26.6395 20.2618 26.1173 20.784C25.5951 21.3062 25.334 21.934 25.334 22.6673C25.334 23.4007 25.5951 24.0284 26.1173 24.5507C26.6395 25.0729 27.2673 25.334 28.0007 25.334C28.734 25.334 29.3618 25.0729 29.884 24.5507Z" />
						</Canvas>
					</Button>
				</StackPanel>
			</Grid>
			<!-- The 688px double card is sized so [double double] with the 16px gap fills the
			     1392px card row exactly (688*2+16); four 336 singles do the same (336*4+16*3).
			     The WrapPanel is LEFT-aligned: a partial row (few devices) starts at the
			     viewport's left edge — 24 from the window edge — instead of floating centered. -->

			<!-- AllowAutoHide off: the overlay bar otherwise materialises only under the pointer,
			     which reads as "no scroll here". Auto visibility still keeps it away entirely
			     while the cards fit; when they overflow, the 4px pgScrollViewer bar stays put —
			     same persistent-bar behaviour as the agreement step.
			     Design redlines, measured against the WINDOW (verified pixel-by-pixel in the
			     running app): leftmost card 24 from the left window edge, bar 10 from the right
			     window edge with a 10px gap to the cards, track from 24 below the header band
			     to 24 above the window bottom. The window edge is NOT this view's edge — on the
			     Home step MainWindow's RootLayoutGrid carries Margin=24 on all sides (set at
			     runtime by GetLayoutProfile in MainWindow.axaml.cs — NOT the margin in
			     MainWindow.axaml, which the profile overrides), and HomeView's own page Grid
			     adds another 20 — the margins below compensate as follows:
			     - left: -20 cancels the page margin so the viewport starts at the host's 24 —
			       which is exactly where the leftmost card must sit;
			     - right: -44 = 20 (page) + 24 (host) puts the ScrollViewer edge on the
			       window edge; the bar's own 10px right margin is then measured from the
			       real window edge, and the bar column reserves 10+4+10 so the viewport
			       ends 10+4+10 = 24 before it — making the viewport exactly the 1392px
			       card row wide at the default 1440 window (1440-24-24): zero centering
			       slack, cards pinned 24 from the left edge and 10 from the bar;
			     - bottom: -20 lands the ScrollViewer 24 above the window bottom
			       (24 host + 20 page - 20 = 24), which is where the track ends;
			     - top: the 24 top inset IS the design's 24 below the header band;
			     - the vertical insets live HERE, outside the scrollable content (the
			       ItemsControl carries none) — inside they inflate the scroll extent and
			       summon the bar even when every card is already on screen. -->
			<!-- The 24px top inset is split 14 (outer margin) + 10 (ItemsControl margin, INSIDE
			     the scrollable content): the hover lift (DeviceCardBase, translateY(-10px))
			     renders above a first-row card, and the ScrollViewer's ScrollContentPresenter
			     always clips at the viewport edge — every ClipToBounds="False" around it
			     notwithstanding — so the lift needs its 10px of headroom inside that clip.
			     One outer margin of 24 put the clip line exactly on the cards' top edge and
			     visibly cut the rising card. The split keeps every design position: cards sit
			     at the same 14+10 = 24 below the header, and extent and viewport both grow by
			     the same 10px, so the no-scroll fit (and the bar's appearance) is unchanged.
			     The bar keeps its 24 via the extra 10 in its own top margin below. -->
			<ScrollViewer Grid.Row="1"
						  Classes="pgScrollViewer"
						  ClipToBounds="False"
						  AllowAutoHide="False"
						  Margin="-20,14,-44,-20"
						  HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Auto">
					<ScrollViewer.Styles>
						<Style Selector="ScrollBar:vertical">
							<Setter Property="Margin" Value="10,10,10,0" />
						</Style>
					</ScrollViewer.Styles>
					<ItemsControl ClipToBounds="False"
								  Margin="0,10,0,0"
								  ItemsSource="{Binding Devices}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="16" LineSpacing="16" ClipToBounds="False"
									   HorizontalAlignment="Left"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.DataTemplates>
						<DataTemplate DataType="{x:Type viewmodels:SingleCardViewModel}">
							<local:SingleCard Tapped="OnDeviceCardTapped"/>
						</DataTemplate>
						<DataTemplate DataType="{x:Type viewmodels:DoubleCardViewModel}">
							<local:DoubleCard Tapped="OnDeviceCardTapped"/>
						</DataTemplate>
						<DataTemplate DataType="{x:Type viewmodels:InactiveDeviceCardViewModel}">
							<Panel>
								<local:InactiveDeviceCard IsVisible="{Binding !IsDouble}"/>
								<local:InactiveDoubleCard IsVisible="{Binding IsDouble}"/>
							</Panel>
						</DataTemplate>
						<DataTemplate DataType="{x:Type viewmodels:AddDeviceCardViewModel}">
							<local:AddDeviceCard/>
						</DataTemplate>
					</ItemsControl.DataTemplates>
					</ItemsControl>
				</ScrollViewer>
		</Grid>

		<!-- Profile dropdown popup -->
		<Popup x:Name="ProfilePopup"
			   PlacementTarget="{Binding ElementName=ProfileButton}"
			   Placement="BottomEdgeAlignedRight"
			   HorizontalOffset="21"
			   VerticalOffset="-12"
			   IsLightDismissEnabled="True">
			<!-- MinWidth, never a fixed Width: the rows carry localized text, and at 204 the uk
			     "Зв'язатися з нами" ended exactly flush with the row's right edge (QA
			     2026-08-31 — "додати відступ"). The chamfered background is therefore built
			     from 16px corner caps plus a stretching middle, so a longer label widens the
			     whole menu instead of running out of room; MaxWidth bounds the greeting,
			     whose username is arbitrary and ellipsized. -->
			<Panel MinWidth="204" MaxWidth="280" Margin="20">
				<Panel.Effect>
					<DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="40" Color="#6357FF" Opacity="0.3"/>
				</Panel.Effect>
				<Grid ColumnDefinitions="16,*,16">
					<Rectangle Grid.Column="0" Fill="Black" Margin="0,0,0,16"/>
					<Path Grid.Column="0" Fill="Black" VerticalAlignment="Bottom" Width="16" Height="16"
						  Data="M16 16 L0 0 L16 0 Z"/>
					<Rectangle Grid.Column="1" Fill="Black"/>
					<Path Grid.Column="2" Fill="Black" VerticalAlignment="Top" Width="16" Height="16"
						  Data="M0 0 L16 16 L0 16 Z"/>
					<Rectangle Grid.Column="2" Fill="Black" Margin="0,16,0,0"/>
				</Grid>
				<StackPanel Margin="0,0,0,12">
					<Border Height="44" Padding="24,0,16,0">
						<TextBlock Text="{Binding GreetingText}"
								   TextTrimming="CharacterEllipsis"
								   ToolTip.Tip="{Binding GreetingText}"
								   Foreground="#BEBCEA"
								   Opacity="0.7"
								   VerticalAlignment="Center"
								   FontFamily="Segoe UI"
								   FontWeight="Regular"
								   FontSize="16"/>
					</Border>
					<Button Classes="profileMenuItem" Click="OnProfileMenuProfileClick">
						<StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
							<Path Width="20" Height="20" Stretch="Uniform" Fill="#B3BEBCEA" VerticalAlignment="Center"
								  Data="M5.175 6.825C4.39167 6.04167 4 5.1 4 4C4 2.9 4.39167 1.95833 5.175 1.175C5.95833 0.391667 6.9 0 8 0C9.1 0 10.0417 0.391667 10.825 1.175C11.6083 1.95833 12 2.9 12 4C12 5.1 11.6083 6.04167 10.825 6.825C10.0417 7.60833 9.1 8 8 8C6.9 8 5.95833 7.60833 5.175 6.825ZM0 16V13.2C0 12.6333 0.145833 12.1125 0.4375 11.6375C0.729167 11.1625 1.11667 10.8 1.6 10.55C2.63333 10.0333 3.68333 9.64583 4.75 9.3875C5.81667 9.12917 6.9 9 8 9C9.1 9 10.1833 9.12917 11.25 9.3875C12.3167 9.64583 13.3667 10.0333 14.4 10.55C14.8833 10.8 15.2708 11.1625 15.5625 11.6375C15.8542 12.1125 16 12.6333 16 13.2V16H0ZM2 14H14V13.2C14 13.0167 13.9542 12.85 13.8625 12.7C13.7708 12.55 13.65 12.4333 13.5 12.35C12.6 11.9 11.6917 11.5625 10.775 11.3375C9.85833 11.1125 8.93333 11 8 11C7.06667 11 6.14167 11.1125 5.225 11.3375C4.30833 11.5625 3.4 11.9 2.5 12.35C2.35 12.4333 2.22917 12.55 2.1375 12.7C2.04583 12.85 2 13.0167 2 13.2V14ZM9.4125 5.4125C9.80417 5.02083 10 4.55 10 4C10 3.45 9.80417 2.97917 9.4125 2.5875C9.02083 2.19583 8.55 2 8 2C7.45 2 6.97917 2.19583 6.5875 2.5875C6.19583 2.97917 6 3.45 6 4C6 4.55 6.19583 5.02083 6.5875 5.4125C6.97917 5.80417 7.45 6 8 6C8.55 6 9.02083 5.80417 9.4125 5.4125Z"/>
							<TextBlock Text="{DynamicResource HomeView_ProfileMenu_Profile}" Foreground="White" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Classes="profileMenuItem" Click="OnMenuContactUsClick">
						<StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
							<Path Width="20" Height="20" Stretch="Uniform" Fill="#B3BEBCEA" VerticalAlignment="Center"
								  Data="M9 20L8.75 17H8.5C6.13333 17 4.125 16.175 2.475 14.525C0.825 12.875 0 10.8667 0 8.5C0 6.13333 0.825 4.125 2.475 2.475C4.125 0.825 6.13333 0 8.5 0C9.68333 0 10.7875 0.220833 11.8125 0.6625C12.8375 1.10417 13.7375 1.7125 14.5125 2.4875C15.2875 3.2625 15.8958 4.1625 16.3375 5.1875C16.7792 6.2125 17 7.31667 17 8.5C17 9.75 16.7958 10.95 16.3875 12.1C15.9792 13.25 15.4208 14.3167 14.7125 15.3C14.0042 16.2833 13.1625 17.175 12.1875 17.975C11.2125 18.775 10.15 19.45 9 20ZM11 16.35C12.1833 15.35 13.1458 14.1792 13.8875 12.8375C14.6292 11.4958 15 10.05 15 8.5C15 6.68333 14.3708 5.14583 13.1125 3.8875C11.8542 2.62917 10.3167 2 8.5 2C6.68333 2 5.14583 2.62917 3.8875 3.8875C2.62917 5.14583 2 6.68333 2 8.5C2 10.3167 2.62917 11.8542 3.8875 13.1125C5.14583 14.3708 6.68333 15 8.5 15H11V16.35ZM9.2 13.675C9.4 13.475 9.5 13.2333 9.5 12.95C9.5 12.6667 9.4 12.425 9.2 12.225C9 12.025 8.75833 11.925 8.475 11.925C8.19167 11.925 7.95 12.025 7.75 12.225C7.55 12.425 7.45 12.6667 7.45 12.95C7.45 13.2333 7.55 13.475 7.75 13.675C7.95 13.875 8.19167 13.975 8.475 13.975C8.75833 13.975 9 13.875 9.2 13.675ZM7.75 10.8H9.25C9.25 10.3 9.3 9.95 9.4 9.75C9.5 9.55 9.81667 9.18333 10.35 8.65C10.65 8.35 10.9 8.025 11.1 7.675C11.3 7.325 11.4 6.95 11.4 6.55C11.4 5.7 11.1125 5.0625 10.5375 4.6375C9.9625 4.2125 9.28333 4 8.5 4C7.76667 4 7.15 4.20417 6.65 4.6125C6.15 5.02083 5.8 5.51667 5.6 6.1L7 6.65C7.08333 6.36667 7.24167 6.0875 7.475 5.8125C7.70833 5.5375 8.05 5.4 8.5 5.4C8.95 5.4 9.2875 5.525 9.5125 5.775C9.7375 6.025 9.85 6.3 9.85 6.6C9.85 6.88333 9.76667 7.1375 9.6 7.3625C9.43333 7.5875 9.23333 7.81667 9 8.05C8.41667 8.55 8.0625 8.94583 7.9375 9.2375C7.8125 9.52917 7.75 10.05 7.75 10.8Z"/>
							<TextBlock Text="{DynamicResource HomeView_Menu_ContactUs}" Foreground="White" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Classes="profileMenuItem" Click="OnMenuInformationClick">
						<StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
							<Path Width="20" Height="20" Stretch="Uniform" Fill="#B3BEBCEA" VerticalAlignment="Center"
								  Data="M9 15H11V9H9V15ZM10.7125 6.7125C10.9042 6.52083 11 6.28333 11 6C11 5.71667 10.9042 5.47917 10.7125 5.2875C10.5208 5.09583 10.2833 5 10 5C9.71667 5 9.47917 5.09583 9.2875 5.2875C9.09583 5.47917 9 5.71667 9 6C9 6.28333 9.09583 6.52083 9.2875 6.7125C9.47917 6.90417 9.71667 7 10 7C10.2833 7 10.5208 6.90417 10.7125 6.7125ZM10 20C8.61667 20 7.31667 19.7375 6.1 19.2125C4.88333 18.6875 3.825 17.975 2.925 17.075C2.025 16.175 1.3125 15.1167 0.7875 13.9C0.2625 12.6833 0 11.3833 0 10C0 8.61667 0.2625 7.31667 0.7875 6.1C1.3125 4.88333 2.025 3.825 2.925 2.925C3.825 2.025 4.88333 1.3125 6.1 0.7875C7.31667 0.2625 8.61667 0 10 0C11.3833 0 12.6833 0.2625 13.9 0.7875C15.1167 1.3125 16.175 2.025 17.075 2.925C17.975 3.825 18.6875 4.88333 19.2125 6.1C19.7375 7.31667 20 8.61667 20 10C20 11.3833 19.7375 12.6833 19.2125 13.9C18.6875 15.1167 17.975 16.175 17.075 17.075C16.175 17.975 15.1167 18.6875 13.9 19.2125C12.6833 19.7375 11.3833 20 10 20ZM10 18C12.2333 18 14.125 17.225 15.675 15.675C17.225 14.125 18 12.2333 18 10C18 7.76667 17.225 5.875 15.675 4.325C14.125 2.775 12.2333 2 10 2C7.76667 2 5.875 2.775 4.325 4.325C2.775 5.875 2 7.76667 2 10C2 12.2333 2.775 14.125 4.325 15.675C5.875 17.225 7.76667 18 10 18Z"/>
							<TextBlock Text="{DynamicResource HomeView_Menu_Information}" Foreground="White" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Classes="profileMenuItem" Command="{Binding LogoutCommand}">
						<StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
							<Path Width="20" Height="20" Stretch="Uniform" Fill="#B3BEBCEA" VerticalAlignment="Center"
								  Data="M2 18C1.45 18 0.979167 17.8042 0.5875 17.4125C0.195833 17.0208 0 16.55 0 16V2C0 1.45 0.195833 0.979167 0.5875 0.5875C0.979167 0.195833 1.45 0 2 0H9V2H2V16H9V18H2ZM13 14L11.625 12.55L14.175 10H6V8H14.175L11.625 5.45L13 4L18 9L13 14Z"/>
							<TextBlock Text="{DynamicResource HomeView_ProfileMenu_LogOut}" Foreground="White" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Panel>
		</Popup>

		<!-- Guest dropdown popup -->
		<Popup x:Name="GuestPopup"
			   PlacementTarget="{Binding ElementName=GuestButton}"
			   Placement="BottomEdgeAlignedRight"
			   HorizontalOffset="21"
			   VerticalOffset="-12"
			   IsLightDismissEnabled="True">
			<!-- Same stretch-to-content chrome as ProfilePopup above, and it matters more here:
			     these rows render at 16px SemiBold, where the uk labels did not fit the fixed
			     204 at all. -->
			<Panel MinWidth="204" MaxWidth="280" Margin="20">
				<Panel.Effect>
					<DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="40" Color="#6357FF" Opacity="0.3"/>
				</Panel.Effect>
				<Grid ColumnDefinitions="16,*,16">
					<Rectangle Grid.Column="0" Fill="Black" Margin="0,0,0,16"/>
					<Path Grid.Column="0" Fill="Black" VerticalAlignment="Bottom" Width="16" Height="16"
						  Data="M16 16 L0 0 L16 0 Z"/>
					<Rectangle Grid.Column="1" Fill="Black"/>
					<Path Grid.Column="2" Fill="Black" VerticalAlignment="Top" Width="16" Height="16"
						  Data="M0 0 L16 16 L0 16 Z"/>
					<Rectangle Grid.Column="2" Fill="Black" Margin="0,16,0,0"/>
				</Grid>
				<StackPanel Margin="0,0,0,8">
					<Border Height="44" Padding="16,0,16,0">
						<TextBlock Text="{DynamicResource HomeView_GuestMenu_Title}"
								   Foreground="#BEBCEA"
								   Opacity="0.7"
								   VerticalAlignment="Center"
								   FontFamily="Segoe UI"
								   FontWeight="SemiBold"
								   FontSize="18"
								   LineHeight="24"/>
					</Border>
					<Button Classes="profileMenuItem" Height="44" Click="OnGuestMenuSignUpClick">
						<StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
							<Path Width="20" Height="20" Stretch="Uniform" Fill="#B3BEBCEA" VerticalAlignment="Center"
								  Data="M9 18V16H16V2H9V0H16C16.55 0 17.0208 0.195833 17.4125 0.5875C17.8042 0.979167 18 1.45 18 2V16C18 16.55 17.8042 17.0208 17.4125 17.4125C17.0208 17.8042 16.55 18 16 18H9ZM7 14L5.625 12.55L8.175 10H0V8H8.175L5.625 5.45L7 4L12 9L7 14Z"/>
							<TextBlock Text="{DynamicResource HomeView_GuestMenu_SignUp}" Foreground="White" VerticalAlignment="Center"
									   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" LineHeight="24"/>
						</StackPanel>
					</Button>
					<Button Classes="profileMenuItem" Height="44" Click="OnMenuContactUsClick">
						<StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
							<Path Width="20" Height="20" Stretch="Uniform" Fill="#B3BEBCEA" VerticalAlignment="Center"
								  Data="M9 20L8.75 17H8.5C6.13333 17 4.125 16.175 2.475 14.525C0.825 12.875 0 10.8667 0 8.5C0 6.13333 0.825 4.125 2.475 2.475C4.125 0.825 6.13333 0 8.5 0C9.68333 0 10.7875 0.220833 11.8125 0.6625C12.8375 1.10417 13.7375 1.7125 14.5125 2.4875C15.2875 3.2625 15.8958 4.1625 16.3375 5.1875C16.7792 6.2125 17 7.31667 17 8.5C17 9.75 16.7958 10.95 16.3875 12.1C15.9792 13.25 15.4208 14.3167 14.7125 15.3C14.0042 16.2833 13.1625 17.175 12.1875 17.975C11.2125 18.775 10.15 19.45 9 20ZM11 16.35C12.1833 15.35 13.1458 14.1792 13.8875 12.8375C14.6292 11.4958 15 10.05 15 8.5C15 6.68333 14.3708 5.14583 13.1125 3.8875C11.8542 2.62917 10.3167 2 8.5 2C6.68333 2 5.14583 2.62917 3.8875 3.8875C2.62917 5.14583 2 6.68333 2 8.5C2 10.3167 2.62917 11.8542 3.8875 13.1125C5.14583 14.3708 6.68333 15 8.5 15H11V16.35ZM9.2 13.675C9.4 13.475 9.5 13.2333 9.5 12.95C9.5 12.6667 9.4 12.425 9.2 12.225C9 12.025 8.75833 11.925 8.475 11.925C8.19167 11.925 7.95 12.025 7.75 12.225C7.55 12.425 7.45 12.6667 7.45 12.95C7.45 13.2333 7.55 13.475 7.75 13.675C7.95 13.875 8.19167 13.975 8.475 13.975C8.75833 13.975 9 13.875 9.2 13.675ZM7.75 10.8H9.25C9.25 10.3 9.3 9.95 9.4 9.75C9.5 9.55 9.81667 9.18333 10.35 8.65C10.65 8.35 10.9 8.025 11.1 7.675C11.3 7.325 11.4 6.95 11.4 6.55C11.4 5.7 11.1125 5.0625 10.5375 4.6375C9.9625 4.2125 9.28333 4 8.5 4C7.76667 4 7.15 4.20417 6.65 4.6125C6.15 5.02083 5.8 5.51667 5.6 6.1L7 6.65C7.08333 6.36667 7.24167 6.0875 7.475 5.8125C7.70833 5.5375 8.05 5.4 8.5 5.4C8.95 5.4 9.2875 5.525 9.5125 5.775C9.7375 6.025 9.85 6.3 9.85 6.6C9.85 6.88333 9.76667 7.1375 9.6 7.3625C9.43333 7.5875 9.23333 7.81667 9 8.05C8.41667 8.55 8.0625 8.94583 7.9375 9.2375C7.8125 9.52917 7.75 10.05 7.75 10.8Z"/>
							<TextBlock Text="{DynamicResource HomeView_Menu_ContactUs}" Foreground="White" VerticalAlignment="Center"
									   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" LineHeight="24"/>
						</StackPanel>
					</Button>
					<Button Classes="profileMenuItem" Height="44" Click="OnMenuInformationClick">
						<StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0">
							<Path Width="20" Height="20" Stretch="Uniform" Fill="#B3BEBCEA" VerticalAlignment="Center"
								  Data="M9 15H11V9H9V15ZM10.7125 6.7125C10.9042 6.52083 11 6.28333 11 6C11 5.71667 10.9042 5.47917 10.7125 5.2875C10.5208 5.09583 10.2833 5 10 5C9.71667 5 9.47917 5.09583 9.2875 5.2875C9.09583 5.47917 9 5.71667 9 6C9 6.28333 9.09583 6.52083 9.2875 6.7125C9.47917 6.90417 9.71667 7 10 7C10.2833 7 10.5208 6.90417 10.7125 6.7125ZM10 20C8.61667 20 7.31667 19.7375 6.1 19.2125C4.88333 18.6875 3.825 17.975 2.925 17.075C2.025 16.175 1.3125 15.1167 0.7875 13.9C0.2625 12.6833 0 11.3833 0 10C0 8.61667 0.2625 7.31667 0.7875 6.1C1.3125 4.88333 2.025 3.825 2.925 2.925C3.825 2.025 4.88333 1.3125 6.1 0.7875C7.31667 0.2625 8.61667 0 10 0C11.3833 0 12.6833 0.2625 13.9 0.7875C15.1167 1.3125 16.175 2.025 17.075 2.925C17.975 3.825 18.6875 4.88333 19.2125 6.1C19.7375 7.31667 20 8.61667 20 10C20 11.3833 19.7375 12.6833 19.2125 13.9C18.6875 15.1167 17.975 16.175 17.075 17.075C16.175 17.975 15.1167 18.6875 13.9 19.2125C12.6833 19.7375 11.3833 20 10 20ZM10 18C12.2333 18 14.125 17.225 15.675 15.675C17.225 14.125 18 12.2333 18 10C18 7.76667 17.225 5.875 15.675 4.325C14.125 2.775 12.2333 2 10 2C7.76667 2 5.875 2.775 4.325 4.325C2.775 5.875 2 7.76667 2 10C2 12.2333 2.775 14.125 4.325 15.675C5.875 17.225 7.76667 18 10 18Z"/>
							<TextBlock Text="{DynamicResource HomeView_Menu_Information}" Foreground="White" VerticalAlignment="Center"
									   FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" LineHeight="24"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Panel>
		</Popup>
	</Grid>
</UserControl>
