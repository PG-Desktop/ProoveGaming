				<StackPanel HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Orientation="Horizontal"
							Spacing="0">
					<Grid Width="117" Height="56">
						<Polygon Points="0,56 15,0 117,0 102,56" Fill="#4D6357FF" />
						<TextBlock Text="{DynamicResource HomeView_Tab_Devices}"
								   FontFamily="{DynamicResource AppPixelFont}"
								   FontSize="18"
								   FontWeight="Regular"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Classes="tab selected"/>
					</Grid>
					<Grid Width="100" Height="56">
						<Polygon x:Name="GamesHoverBg"
								 Points="0,56 15,0 100,0 85,56"
								 Fill="#336357FF"
