<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:viewmodels="using:ProoveGaming.App.ViewModels"
			 mc:Ignorable="d"
			 x:DataType="viewmodels:DeviceDetailsViewModel"
			 x:Class="ProoveGaming.App.Views.DeviceDetailsSections.FirmwareSectionView">
	<UserControl.Styles>
		<!-- Variant of the shared sectionActionButton (App.axaml): only the fill differs, so the
			 call site applies both classes and this style holds just the differences — including
			 the :disabled presenter re-state, which the standalone copy lacked and which let the
			 theme's dark disabled resources swallow the button in Bluetooth mode (PR #124 M2). -->
		<Style Selector="Button.firmwareButton">
			<Setter Property="Background" Value="#1A6357FF" />
		</Style>
		<Style Selector="Button.firmwareButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#4D6357FF" />
			<Setter Property="Foreground" Value="#FFFFFF" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer IsVisible="{Binding IsFirmwareSection}">
		<StackPanel Margin="0,16,0,0" Spacing="8" Width="336" HorizontalAlignment="Left"
					IsEnabled="{Binding !Device.IsBluetoothConfigLocked, FallbackValue=True}">

			<!-- Top status block: title + green-check status row + subtitle (76h overall per design).
				 Carries bluetoothLocked itself — the button below must stay outside the dimmed
				 subtree so its absolute :disabled colours are not halved (PR #124 M1). -->
			<StackPanel Margin="0,0,0,16" Classes="bluetoothLocked">
				<TextBlock Text="{Binding FirmwareVersionText}"
						   Foreground="#FFFFFF"
						   FontFamily="{DynamicResource BaseAppFont}"
						   FontSize="18"
						   LineHeight="24"
						   LetterSpacing="0"
						   VerticalAlignment="Center" />

				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,14,0,0">
					<Path Grid.Column="0" Width="17" Height="17" Stretch="Uniform" Fill="#00CE4F"
						  VerticalAlignment="Top"
						  Margin="0,2,0,0"
						  Data="M7.16667 12.1667L13.0417 6.29167L11.875 5.125L7.16667 9.83333L4.79167 7.45833L3.625 8.625L7.16667 12.1667ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z" />
					<TextBlock Grid.Column="1"
							   Text="{DynamicResource DeviceDetails_Firmware_UpToDate}"
							   Foreground="#B2BEBCEA"
							   FontFamily="{DynamicResource BaseAppFont}"
							   FontSize="14"
							   LineHeight="20"
							   LetterSpacing="0"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center" />
				</Grid>

			</StackPanel>

			<Button Classes="sectionActionButton firmwareButton"
					Content="{DynamicResource DeviceDetails_Firmware_CheckForUpdates}"
					Command="{Binding CheckFirmwareUpdatesCommand}" />

		</StackPanel>
	</ScrollViewer>
</UserControl>
