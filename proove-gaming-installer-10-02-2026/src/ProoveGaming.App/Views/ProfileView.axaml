<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:ProoveGaming.App.ViewModels"
             xmlns:converters="using:ProoveGaming.App.Converters"
             xmlns:avaConverters="using:Avalonia.Data.Converters"
             xmlns:commonControls="using:ProoveGaming.Common.Controls"
             mc:Ignorable="d" d:DesignWidth="1392" d:DesignHeight="844"
             x:DataType="viewmodels:ProfileViewModel"
             x:Class="ProoveGaming.App.Views.ProfileView">

    <UserControl.Styles>
        <Style Selector="Border.nicknameField">
            <Setter Property="BorderBrush" Value="#6357FF"/>
        </Style>
        <Style Selector="Border.nicknameField:pointerover">
            <Setter Property="BorderBrush" Value="#786DFF"/>
        </Style>
        <Style Selector="Border.nicknameField.error">
            <Setter Property="BorderBrush" Value="#FF383C"/>
        </Style>
        <Style Selector="Border.nicknameField.error:pointerover">
            <Setter Property="BorderBrush" Value="#FF383C"/>
        </Style>
        <!-- The NavBackBg hover styles live in App.axaml with the other header *Bg styles. -->
        <Style Selector="Path#EditNicknameBg">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button#EditNicknameButton:pointerover Path#EditNicknameBg">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Path.avatarHoverOverlay">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button#AvatarButton:pointerover Path.avatarHoverOverlay">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="TextBox.profileField">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="PlaceholderForeground" Value="#B2BEBCEA"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#336357FF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="400"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TextBox.profileField:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="400"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>
        <Style Selector="TextBox.profileField:focus-within">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="400"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>
        <Style Selector="TextBox.profileField /template/ TextBlock#PART_Placeholder">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="400"/>
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <Grid x:Name="ProfileContent" RowDefinitions="80,*">

        <!-- ══ Header ══ -->
        <Grid Grid.Row="0" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="16">
                <Button x:Name="NavBackButton"
                        Classes="linkButton"
                        Cursor="Hand"
                        Command="{Binding NavigateBackCommand}">
                    <Grid Width="56" Height="56">
                        <Path x:Name="NavBackBg"
                              Fill="#4D6357FF"
                              Data="{StaticResource CutCornerFrameGeometry}"/>
                        <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M5.1 12L12.5667 19.4667L10.6667 21.3333L0 10.6667L10.6667 0L12.5667 1.86667L5.1 9.33333H21.3333V12H5.1Z"/>
                    </Grid>
                </Button>
                <TextBlock Text="{DynamicResource ProfileView_Title}"
                           FontFamily="{DynamicResource AppPixelFont}"
                           FontSize="36"
                           LineHeight="32"
                           FontWeight="250"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══ Octagon + Sidebar Frame ══ -->
        <Grid Grid.Row="1" ColumnDefinitions="160,4,42,668,42"
              HorizontalAlignment="Center" VerticalAlignment="Stretch"
              UseLayoutRounding="False"
              Margin="0,12,0,0">

            <Canvas x:Name="TabControl" Grid.Column="0" Width="160" Height="164" VerticalAlignment="Top">

            <!-- Octagonal background -->
            <Path Fill="#CC000000"
                  Data="M20,0 L140,0 L160,20 L160,144 L140,164 L20,164 L0,144 L0,20 Z"/>

            <!-- ACCOUNT highlight -->
            <Rectangle Canvas.Left="28" Canvas.Top="16" Width="104" Height="8" Fill="#336357FF"
                       IsVisible="{Binding IsAccountHighlighted}"/>
            <Rectangle Canvas.Left="20" Canvas.Top="24" Width="120" Height="48" Fill="#336357FF"
                       IsVisible="{Binding IsAccountHighlighted}"/>
            <Rectangle Canvas.Left="28" Canvas.Top="72" Width="104" Height="8" Fill="#336357FF"
                       IsVisible="{Binding IsAccountHighlighted}"/>

            <!-- SECURITY highlight -->
            <Rectangle Canvas.Left="28" Canvas.Top="84" Width="104" Height="8" Fill="#336357FF"
                       IsVisible="{Binding IsSecurityHighlighted}"/>
            <Rectangle Canvas.Left="20" Canvas.Top="92" Width="120" Height="48" Fill="#336357FF"
                       IsVisible="{Binding IsSecurityHighlighted}"/>
            <Rectangle Canvas.Left="28" Canvas.Top="140" Width="104" Height="8" Fill="#336357FF"
                       IsVisible="{Binding IsSecurityHighlighted}"/>

            <!-- ACCOUNT icon + label. Centered as a GROUP inside the highlight zone (y 16..80)
                 rather than pinned at fixed Canvas offsets: the Ukrainian label is two lines
                 (explicit break in the resource), the English one is one, and group-centering
                 keeps both variants vertically balanced in the tab. -->
            <Border Canvas.Left="20" Canvas.Top="16" Width="120" Height="64">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <Path Fill="{Binding AccountIconBrush}" HorizontalAlignment="Center"
                          Data="M8 12C8.55 12 9.02083 11.8042 9.4125 11.4125C9.80417 11.0208 10 10.55 10 10C10 9.45 9.80417 8.97917 9.4125 8.5875C9.02083 8.19583 8.55 8 8 8C7.45 8 6.97917 8.19583 6.5875 8.5875C6.19583 8.97917 6 9.45 6 10C6 10.55 6.19583 11.0208 6.5875 11.4125C6.97917 11.8042 7.45 12 8 12ZM4 16H12V15.425C12 15.025 11.8917 14.6583 11.675 14.325C11.4583 13.9917 11.1583 13.7417 10.775 13.575C10.3417 13.3917 9.89583 13.25 9.4375 13.15C8.97917 13.05 8.5 13 8 13C7.5 13 7.02083 13.05 6.5625 13.15C6.10417 13.25 5.65833 13.3917 5.225 13.575C4.84167 13.7417 4.54167 13.9917 4.325 14.325C4.10833 14.6583 4 15.025 4 15.425V16ZM14 20H2C1.45 20 0.979167 19.8042 0.5875 19.4125C0.195833 19.0208 0 18.55 0 18V2C0 1.45 0.195833 0.979167 0.5875 0.5875C0.979167 0.195833 1.45 0 2 0H10L16 6V18C16 18.55 15.8042 19.0208 15.4125 19.4125C15.0208 19.8042 14.55 20 14 20ZM14 18V6.85L9.15 2H2V18H14Z"/>
                    <TextBlock Text="{DynamicResource ProfileView_Nav_Account}" TextAlignment="Center"
                               Width="120"
                               FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="12" LineHeight="16" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>

            <!-- SECURITY icon -->
            <Path Canvas.Left="72" Canvas.Top="94" Fill="{Binding SecurityIconBrush}"
                  Data="M6.5 13H9.5L8.925 9.775C9.25833 9.60833 9.52083 9.36667 9.7125 9.05C9.90417 8.73333 10 8.38333 10 8C10 7.45 9.80417 6.97917 9.4125 6.5875C9.02083 6.19583 8.55 6 8 6C7.45 6 6.97917 6.19583 6.5875 6.5875C6.19583 6.97917 6 7.45 6 8C6 8.38333 6.09583 8.73333 6.2875 9.05C6.47917 9.36667 6.74167 9.60833 7.075 9.775L6.5 13ZM8 20C5.68333 19.4167 3.77083 18.0875 2.2625 16.0125C0.754167 13.9375 0 11.6333 0 9.1V3L8 0L16 3V9.1C16 11.6333 15.2458 13.9375 13.7375 16.0125C12.2292 18.0875 10.3167 19.4167 8 20ZM8 17.9C9.73333 17.35 11.1667 16.25 12.3 14.6C13.4333 12.95 14 11.1167 14 9.1V4.375L8 2.125L2 4.375V9.1C2 11.1167 2.56667 12.95 3.7 14.6C4.83333 16.25 6.26667 17.35 8 17.9Z"/>

            <!-- SECURITY label -->
            <TextBlock Canvas.Left="20" Canvas.Top="121" Width="120"
                       Text="{DynamicResource ProfileView_Nav_Security}" TextAlignment="Center"
                       FontFamily="Segoe UI" FontWeight="SemiBold"
                       FontSize="12" LineHeight="16" Foreground="#FFFFFF"/>

            <!-- Clickable overlays (on top for hit-testing) -->
            <Button Canvas.Left="0" Canvas.Top="0" Width="160" Height="82"
                    Classes="linkButton" Cursor="Hand"
                    Command="{Binding SelectAccountCommand}"
                    PointerEntered="OnAccountPointerEntered"
                    PointerExited="OnNavItemPointerExited"/>
            <Button Canvas.Left="0" Canvas.Top="82" Width="160" Height="82"
                    Classes="linkButton" Cursor="Hand"
                    Command="{Binding SelectSecurityCommand}"
                    PointerEntered="OnSecurityPointerEntered"
                    PointerExited="OnNavItemPointerExited"/>

            </Canvas>

            <!-- ══ Left Sidebar Frame ══ -->
            <Grid Grid.Column="2" VerticalAlignment="Stretch" RowDefinitions="21.3145,*,21.3145">
                <Canvas Grid.Row="0" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M0 21.3145 L 21.6462 0 L 42 0 L 42 21.3145 Z"/>
                </Canvas>
                <Rectangle Grid.Row="1" Fill="#CC000000"/>
                <Canvas Grid.Row="2" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M0 0 L 21.6462 21.3145 L 42 21.3145 L 42 0 Z"/>
                </Canvas>
            </Grid>

            <!-- ══ Main Content Background ══ -->
            <Rectangle Grid.Column="3" Fill="#CC000000" VerticalAlignment="Stretch"/>

            <!-- ══ Right Sidebar Frame ══ -->
            <Grid Grid.Column="4" VerticalAlignment="Stretch" RowDefinitions="21.3145,*,21.3145">
                <Canvas Grid.Row="0" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M42 21.3145 L 20.3538 0 L 0 0 L 0 21.3145 Z"/>
                </Canvas>
                <Rectangle Grid.Row="1" Fill="#CC000000"/>
                <Canvas Grid.Row="2" Width="42" Height="21.3145">
                    <Path Fill="#CC000000" Data="M42 0 L 20.3538 21.3145 L 0 21.3145 L 0 0 Z"/>
                </Canvas>
            </Grid>

        </Grid>

        <!-- ══ Account Content ══ -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsAccountSelected}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="164,0,0,0"
                    Width="600">

            <!-- Avatar + Stats Header -->
            <Grid ColumnDefinitions="128,*" Height="128" Margin="0,48,0,0">

                <!-- Octagonal avatar frame -->
                <Button x:Name="AvatarButton"
                        Grid.Column="0"
                        Classes="linkButton"
                        Cursor="Hand"
                        Width="128" Height="128"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Click="OnAvatarButtonClick">
                    <Canvas Width="128" Height="128" Background="Transparent">
                        <Path Fill="#FF6357FF"
                              Data="M109.714 18.2857H128V109.714H109.714V128H18.2857V109.714H0V18.2857H18.2857V0H109.714V18.2857Z"/>
                        <Path IsVisible="{Binding HasAvatar}"
                              RenderOptions.BitmapInterpolationMode="HighQuality"
                              Data="M109.714 18.2857H128V109.714H109.714V128H18.2857V109.714H0V18.2857H18.2857V0H109.714V18.2857Z">
                            <Path.Fill>
                                <ImageBrush Source="{Binding AvatarImage}"
                                            Stretch="UniformToFill"
                                            AlignmentX="Center"
                                            AlignmentY="Center"/>
                            </Path.Fill>
                        </Path>
                        <Path IsVisible="{Binding !HasAvatar}"
                              Fill="White"
                              Data="M47.7 44.6H76.5V47.8H79.7V67H76.5V70.2H54.1V83H47.7V44.6ZM54.1 63.8H73.3V51H54.1V63.8Z"/>
                        <Path Classes="avatarHoverOverlay"
                              Fill="Black" Opacity="0.9"
                              Data="M109.714 18.2857H128V109.714H109.714V128H18.2857V109.714H0V18.2857H18.2857V0H109.714V18.2857Z"/>
                        <Path Classes="avatarHoverOverlay"
                              Fill="White"
                              Data="M64.0002 73.1667C66.0835 73.1667 67.8543 72.4375 69.3127 70.9792C70.771 69.5208 71.5002 67.75 71.5002 65.6667C71.5002 63.5833 70.771 61.8125 69.3127 60.3542C67.8543 58.8958 66.0835 58.1667 64.0002 58.1667C61.9168 58.1667 60.146 58.8958 58.6877 60.3542C57.2293 61.8125 56.5002 63.5833 56.5002 65.6667C56.5002 67.75 57.2293 69.5208 58.6877 70.9792C60.146 72.4375 61.9168 73.1667 64.0002 73.1667ZM64.0002 69.8333C62.8335 69.8333 61.8474 69.4306 61.0418 68.625C60.2363 67.8194 59.8335 66.8333 59.8335 65.6667C59.8335 64.5 60.2363 63.5139 61.0418 62.7083C61.8474 61.9028 62.8335 61.5 64.0002 61.5C65.1668 61.5 66.1529 61.9028 66.9585 62.7083C67.764 63.5139 68.1668 64.5 68.1668 65.6667C68.1668 66.8333 67.764 67.8194 66.9585 68.625C66.1529 69.4306 65.1668 69.8333 64.0002 69.8333ZM50.6668 79C49.7502 79 48.9654 78.6736 48.3127 78.0208C47.6599 77.3681 47.3335 76.5833 47.3335 75.6667V55.6667C47.3335 54.75 47.6599 53.9653 48.3127 53.3125C48.9654 52.6597 49.7502 52.3333 50.6668 52.3333H55.9168L59.0002 49H69.0002L72.0835 52.3333H77.3335C78.2502 52.3333 79.0349 52.6597 79.6877 53.3125C80.3404 53.9653 80.6668 54.75 80.6668 55.6667V75.6667C80.6668 76.5833 80.3404 77.3681 79.6877 78.0208C79.0349 78.6736 78.2502 79 77.3335 79H50.6668ZM50.6668 75.6667H77.3335V55.6667H70.5835L67.5418 52.3333H60.4585L57.4168 55.6667H50.6668V75.6667Z"/>
                    </Canvas>
                </Button>

                <!-- Username + edit icon + stats -->
                <StackPanel Grid.Column="1" Margin="41,28,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{Binding User.DisplayName, FallbackValue='Player'}"
                                   FontFamily="{DynamicResource AppPixelFont}"
                                   FontWeight="250"
                                   FontSize="28"
                                   LineHeight="28"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="EditNicknameButton"
                                Classes="linkButton"
                                Cursor="Hand"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding OpenEditNicknameCommand}">
                            <Grid Width="48" Height="48">
                                <Path x:Name="EditNicknameBg"
                                      Fill="#4D6357FF"
                                      Data="M41.1429 6.85714H48V41.1429H41.1429V48H6.85714V41.1429H0V6.85714H6.85714V0H41.1429V6.85714Z"/>
                                <Path Width="18" Height="18"
                                      Stretch="Uniform"
                                      Fill="#FF6357FF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M2 16H3.425L13.2 6.225L11.775 4.8L2 14.575V16ZM0 18V13.75L13.2 0.575C13.4 0.3917 13.621 0.25 13.863 0.15C14.104 0.05 14.358 0 14.625 0C14.892 0 15.15 0.05 15.4 0.15C15.65 0.25 15.867 0.4 16.05 0.6L17.425 2C17.625 2.1833 17.771 2.4 17.863 2.65C17.954 2.9 18 3.15 18 3.4C18 3.6667 17.954 3.9208 17.863 4.1625C17.771 4.4042 17.625 4.625 17.425 4.825L4.25 18H0ZM12.475 5.525L11.775 4.8L13.2 6.225L12.475 5.525Z"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding JoinedText, FallbackValue=''}"
                               FontFamily="Segoe UI"
                               FontWeight="400"
                               FontSize="16"
                               LineHeight="24"
                               Foreground="#B2BEBCEA"/>
                </StackPanel>
            </Grid>

            <!-- First Name + Last Name -->
            <Grid ColumnDefinitions="291,17,291" Height="55" Margin="0,32,0,0">
                <Border Grid.Column="0"
                        Classes="pgFieldBox"
                        Classes.filled="{Binding User.FirstName, Converter={x:Static converters:StringNotEmptyToBoolConverter.Instance}}">
                    <TextBox Classes="profileField"
                             Padding="21,0,0,0"
                             Text="{Binding User.FirstName}"
                             PlaceholderText="{DynamicResource ProfileView_Placeholder_FirstName}"/>
                </Border>
                <Border Grid.Column="2"
                        Classes="pgFieldBox"
                        Classes.filled="{Binding User.LastName, Converter={x:Static converters:StringNotEmptyToBoolConverter.Instance}}">
                    <TextBox Classes="profileField"
                             Padding="21,0,0,0"
                             Text="{Binding User.LastName}"
                             PlaceholderText="{DynamicResource ProfileView_Placeholder_LastName}"/>
                </Border>
            </Grid>

            <!-- Date of birth -->
            <commonControls:DatePickerView x:Name="DateOfBirthPicker"
                                           Margin="0,17,0,0"
                                           ClipToBounds="False"
                                           Placeholder="{DynamicResource ProfileView_Placeholder_DateOfBirth}"
                                           ZIndex="10" />

            <!-- Phone number -->
            <Border Height="55" Margin="0,17,0,0"
                    Classes="pgFieldBox"
                    Classes.filled="{Binding User.Phone, Converter={x:Static converters:StringNotEmptyToBoolConverter.Instance}}">
                <Grid ColumnDefinitions="53,*">
                    <Path Grid.Column="0"
                          Width="18" Height="18" Stretch="Uniform"
                          Fill="#80BEBCEA"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="19,0,0,0"
                          Data="M16.95 18C14.8667 18 12.8083 17.5458 10.775 16.6375C8.74167 15.7292 6.89167 14.4417 5.225 12.775C3.55833 11.1083 2.27083 9.25833 1.3625 7.225C0.454167 5.19167 0 3.13333 0 1.05C0 0.75 0.1 0.5 0.3 0.3C0.5 0.1 0.75 0 1.05 0H5.1C5.33333 0 5.54167 0.0791667 5.725 0.2375C5.90833 0.395833 6.01667 0.583333 6.05 0.8L6.7 4.3C6.73333 4.56667 6.725 4.79167 6.675 4.975C6.625 5.15833 6.53333 5.31667 6.4 5.45L3.975 7.9C4.30833 8.51667 4.70417 9.1125 5.1625 9.6875C5.62083 10.2625 6.125 10.8167 6.675 11.35C7.19167 11.8667 7.73333 12.3458 8.3 12.7875C8.86667 13.2292 9.46667 13.6333 10.1 14L12.45 11.65C12.6 11.5 12.7958 11.3875 13.0375 11.3125C13.2792 11.2375 13.5167 11.2167 13.75 11.25L17.2 11.95C17.4333 12.0167 17.625 12.1375 17.775 12.3125C17.925 12.4875 18 12.6833 18 12.9V16.95C18 17.25 17.9 17.5 17.7 17.7C17.5 17.9 17.25 18 16.95 18ZM3.025 6L4.675 4.35L4.25 2H2.025C2.10833 2.68333 2.225 3.35833 2.375 4.025C2.525 4.69167 2.74167 5.35 3.025 6ZM11.975 14.95C12.625 15.2333 13.2875 15.4583 13.9625 15.625C14.6375 15.7917 15.3167 15.9 16 15.95V13.75L13.65 13.275L11.975 14.95Z"/>
                    <TextBox Grid.Column="1"
                             Classes="profileField"
                             Text="{Binding User.Phone}"
                             PlaceholderText="{DynamicResource ProfileView_Placeholder_Phone}"/>
                </Grid>
            </Border>

            <!-- Country -->
            <commonControls:CountrySelectView x:Name="CountrySelect"
                                              Margin="0,17,0,0"
                                              ClipToBounds="False"
                                              Placeholder="{DynamicResource ProfileView_Placeholder_Country}"
                                              ZIndex="10" />

            <!-- Email (active/highlighted row) -->
            <Button Height="56" Background="#33BEBCEA" Margin="0,17,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="0" BorderThickness="0" CornerRadius="0" Cursor="Hand"
                    Command="{Binding OpenEditEmailCommand}">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="#44BEBCEA"/>
                    </Style>
                </Button.Styles>
                <Grid ColumnDefinitions="53,*,40">
                    <Path Grid.Column="0"
                          Width="20" Height="16" Stretch="Uniform"
                          Fill="#80BEBCEA"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="19,0,0,0"
                          Data="M2 16C1.45 16 0.979167 15.8042 0.5875 15.4125C0.195833 15.0208 0 14.55 0 14V2C0 1.45 0.195833 0.979167 0.5875 0.5875C0.979167 0.195833 1.45 0 2 0H18C18.55 0 19.0208 0.195833 19.4125 0.5875C19.8042 0.979167 20 1.45 20 2V14C20 14.55 19.8042 15.0208 19.4125 15.4125C19.0208 15.8042 18.55 16 18 16H2ZM10 9L2 4V14H18V4L10 9ZM10 7L18 2H2L10 7ZM2 4V2V14V4Z"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding EmailDisplayText}"
                               FontFamily="Segoe UI"
                               FontWeight="400"
                               FontSize="16"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0"/>
                    <Path Grid.Column="2"
                          Width="8" Height="12" Stretch="Uniform"
                          Fill="#B2BEBCEA"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,22,24,0"
                          Data="M7.4 6L1.4 12L0 10.6L4.6 6L0 1.4L1.4 0L7.4 6Z"/>
                </Grid>
            </Button>

        </StackPanel>

        <!-- ══ Security Content ══ -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsSecuritySelected}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="164,60,0,0"
                    Width="600">

            <!-- Change password row -->
            <Button x:Name="ChangePasswordButton"
                    Classes="linkButton"
                    Width="600" Height="56"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="0"
                    Cursor="Hand"
                    Command="{Binding ChangePasswordCommand}">
                <Border Background="#33BEBCEA" Width="600" Height="56">
                    <Grid ColumnDefinitions="20,16,16,*,8,24">
                        <Path Grid.Column="1" Width="16" Height="21" Stretch="Uniform"
                              Fill="#80BEBCEA" VerticalAlignment="Center"
                              Data="M18 30C17.45 30 16.9792 29.8042 16.5875 29.4125C16.1958 29.0208 16 28.55 16 28V18C16 17.45 16.1958 16.9792 16.5875 16.5875C16.9792 16.1958 17.45 16 18 16H19V14C19 12.6167 19.4875 11.4375 20.4625 10.4625C21.4375 9.4875 22.6167 9 24 9C25.3833 9 26.5625 9.4875 27.5375 10.4625C28.5125 11.4375 29 12.6167 29 14V16H30C30.55 16 31.0208 16.1958 31.4125 16.5875C31.8042 16.9792 32 17.45 32 18V28C32 28.55 31.8042 29.0208 31.4125 29.4125C31.0208 29.8042 30.55 30 30 30H18ZM18 28H30V18H18V28ZM25.4125 24.4125C25.8042 24.0208 26 23.55 26 23C26 22.45 25.8042 21.9792 25.4125 21.5875C25.0208 21.1958 24.55 21 24 21C23.45 21 22.9792 21.1958 22.5875 21.5875C22.1958 21.9792 22 22.45 22 23C22 23.55 22.1958 24.0208 22.5875 24.4125C22.9792 24.8042 23.45 25 24 25C24.55 25 25.0208 24.8042 25.4125 24.4125ZM21 16H27V14C27 13.1667 26.7083 12.4583 26.125 11.875C25.5417 11.2917 24.8333 11 24 11C23.1667 11 22.4583 11.2917 21.875 11.875C21.2917 12.4583 21 13.1667 21 14V16Z"/>
                        <TextBlock Grid.Column="3"
                                   Text="{DynamicResource ProfileView_Security_ChangePassword}"
                                   FontFamily="Segoe UI" FontSize="16" FontWeight="400"
                                   LineHeight="24" Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Path Grid.Column="4" Width="7.4" Height="12" Stretch="Uniform"
                              Fill="#B3BEBCEA" VerticalAlignment="Center"
                              Data="M7.4 6L1.4 12L0 10.6L4.6 6L0 1.4L1.4 0L7.4 6Z"/>
                    </Grid>
                </Border>
            </Button>

            <!-- Delete account link -->
            <Button x:Name="DeleteAccountButton"
                    Classes="linkButton"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Command="{Binding OpenDeleteAccountCommand}">
                <TextBlock Text="{DynamicResource ProfileView_Security_DeleteAccount}"
                           FontFamily="{DynamicResource AppPixelFont}"
                           FontSize="18"
                           FontWeight="250"
                           Foreground="#FF383C"/>
            </Button>

        </StackPanel>

    </Grid>

    <Popup IsOpen="{Binding IsEditNicknameOpen}"
           Placement="AnchorAndGravity"
           PlacementTarget="{Binding $parent[Window]}"
           PlacementAnchor="TopLeft"
           PlacementGravity="BottomRight"
           HorizontalOffset="0"
           VerticalOffset="0"
           OverlayInputPassThroughElement="{Binding $parent[Window]}"
           x:CompileBindings="False">
        <Panel Width="{Binding $parent[Window].Bounds.Width}"
               Height="{Binding $parent[Window].Bounds.Height}"
               Background="#BF0D0737"
               DataContext="{Binding}">
            <Grid Width="620" Height="{Binding PopupHeight}" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Background shapes — collapsed (308) -->
                <Canvas Width="620" Height="308" IsVisible="{Binding !IsNicknameFieldActive}">
                    <Path Fill="#CC000000" Data="M0 21.306L21.477 0L36 0L42 0V21.306H0Z"/>
                    <Rectangle Canvas.Left="0" Canvas.Top="21.306" Width="42" Height="198.793" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M22.591 294.598L22.591 242.677L0 220.099H42V308H36L22.591 294.598Z"/>
                    <Rectangle Canvas.Left="42" Canvas.Top="0" Width="536" Height="308" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M584 0L584 50L620 86L620 0Z"/>
                    <Path Fill="#CC000000" Data="M578 95.367L578 54L620 95.357L578 95.367Z"/>
                    <Rectangle Canvas.Left="578" Canvas.Top="95.367" Width="42" Height="191.318" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M620 286.686L598.354 308H578L578.001 286.686H620Z"/>
                </Canvas>

                <!-- Background shapes — expanded (439) -->
                <Canvas Width="620" Height="439" IsVisible="{Binding IsNicknameFieldActive}">
                    <Path Fill="#CC000000" Data="M0 21.306L21.477 0L36 0L42 0V21.306H0Z"/>
                    <Rectangle Canvas.Left="0" Canvas.Top="21.306" Width="42" Height="329.793" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M22.591 425.598L22.591 373.677L0 351.099H42V439H36L22.591 425.598Z"/>
                    <Rectangle Canvas.Left="42" Canvas.Top="0" Width="536" Height="439" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M584 0L584 50L620 86L620 0Z"/>
                    <Path Fill="#CC000000" Data="M578 95.367L578 54L620 95.357L578 95.367Z"/>
                    <Rectangle Canvas.Left="578" Canvas.Top="95.367" Width="42" Height="322.319" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M620 417.686L598.354 439H578L578.001 417.686H620Z"/>
                </Canvas>

                <!-- Content -->
                <Grid ColumnDefinitions="42,536,42">

                    <!-- Main content -->
                    <StackPanel Grid.Column="1" Margin="0,36,0,0">
                        <TextBlock Text="{DynamicResource ProfileView_EditNickname_Title}"
                                   FontFamily="{DynamicResource AppPixelFont}"
                                   FontSize="28"
                                   LineHeight="28"
                                   FontWeight="250"
                                   Foreground="White"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource ProfileView_EditNickname_Subtitle}"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   LineHeight="24"
                                   FontWeight="400"
                                   Foreground="#B2BEBCEA"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <Border Classes="nicknameField"
                                Classes.active="{Binding IsNicknameFieldActive}"
                                Classes.error="{Binding HasEditNicknameError}"
                                BorderThickness="1" Height="55" Margin="0,32,0,0" Cursor="Hand"
                                PointerPressed="OnNicknameFieldBorderPressed">
                            <Grid ColumnDefinitions="53,*" Cursor="Hand" Background="Transparent">
                                <Path Grid.Column="0"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Fill="#80BEBCEA"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="19,0,0,0"
                                      Data="M8 8C9.1 8 10 7.1 10 6C10 4.9 9.1 4 8 4C6.9 4 6 4.9 6 6C6 7.1 6.9 8 8 8ZM8 10C6.67 10 4 10.67 4 12V13H12V12C12 10.67 9.33 10 8 10Z"/>
                                <TextBox x:Name="NicknameTextBox"
                                         Grid.Column="1"
                                         Classes="profileField"
                                         IsReadOnly="{Binding !IsNicknameFieldActive}"
                                         IsHitTestVisible="{Binding IsNicknameFieldActive}"
                                         Cursor="Hand"
                                         Text="{Binding EditNicknameText}"
                                         PlaceholderText="{DynamicResource ProfileView_EditNickname_Placeholder}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding EditNicknameError}"
                                   IsVisible="{Binding EditNicknameError, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FF383C"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <!-- Recommended nicknames divider — same markup as the registration step -->
                        <Grid IsVisible="{Binding HasNicknameSuggestions}"
                              ColumnDefinitions="*,Auto,*"
                              Margin="0,32,0,0" Height="20"
                              HorizontalAlignment="Stretch">
                            <Path Grid.Column="0" Classes="suggestionDivider" />
                            <TextBlock Grid.Column="1"
                                       Classes="suggestionDividerLabel"
                                       Text="{DynamicResource ProfileView_EditNickname_Recommended}" />
                            <Path Grid.Column="2" Classes="suggestionDivider" />
                        </Grid>

                        <!-- Suggestions row. MaxWidth on the chips is the one deviation from the
                             registration step: this popup's content column is 536px wide, not 599,
                             so three max-length (20-char) nicknames would otherwise spill outside
                             the frame. 160 = (536 - 20 refresh - 16 - 2x8 gaps) / 3. -->
                        <Grid IsVisible="{Binding HasNicknameSuggestions}"
                              Margin="0,16,0,0"
                              HorizontalAlignment="Center"
                              ColumnDefinitions="Auto,8,Auto,8,Auto,16,Auto">
                            <Grid.Styles>
                                <Style Selector="Button.suggestionButton">
                                    <Setter Property="MaxWidth" Value="160" />
                                </Style>
                            </Grid.Styles>
                            <Button Grid.Column="0"
                                    Classes="suggestionButton"
                                    Content="{Binding NicknameSuggestions[0]}"
                                    Command="{Binding SelectSuggestionCommand}"
                                    CommandParameter="{Binding NicknameSuggestions[0]}"
                                    Click="OnSuggestionClick" />
                            <Button Grid.Column="2"
                                    Classes="suggestionButton"
                                    Content="{Binding NicknameSuggestions[1]}"
                                    Command="{Binding SelectSuggestionCommand}"
                                    CommandParameter="{Binding NicknameSuggestions[1]}"
                                    Click="OnSuggestionClick" />
                            <Button Grid.Column="4"
                                    Classes="suggestionButton"
                                    Content="{Binding NicknameSuggestions[2]}"
                                    Command="{Binding SelectSuggestionCommand}"
                                    CommandParameter="{Binding NicknameSuggestions[2]}"
                                    Click="OnSuggestionClick" />
                            <Button Grid.Column="6"
                                    Classes="linkButton"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Command="{Binding RefreshSuggestionsCommand}">
                                <commonControls:SvgImageView
                                    SourceUri="avares://ProoveGaming.Common/Assets/Icons/Autorenew.svg"
                                    Width="20" Height="20"
                                    Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!-- 42, not 28: the popup frame is a fixed 439px canvas, and the registration
                             divider spacing is 14px tighter than what this dialog used to have.
                             The extra margin keeps the buttons where they were in the frame. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,42,0,0">
                            <!-- Auto width + side padding, not a fixed Width: the Ukrainian
                                 СКАСУВАТИ / ПІДТВЕРДИТИ at 18px pixel font clipped inside the
                                 old 104/111 boxes. Same text+16px pattern as the preset dialogs. -->
                            <Button Classes="secondaryButton"
                                    Command="{Binding CancelEditNicknameCommand}"
                                    Content="{DynamicResource Button_Cancel}"
                                    Padding="16,0" Height="39"
                                    FontSize="18" FontWeight="250"/>
                            <Button Classes="primaryButton"
                                    Command="{Binding ConfirmEditNicknameCommand}"
                                    Content="{DynamicResource Button_Confirm}"
                                    Padding="16,0" Height="40"
                                    FontSize="18" FontWeight="250"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right sidebar close button -->
                    <Canvas Grid.Column="2" Width="42" VerticalAlignment="Top">
                        <Button Canvas.Left="0" Canvas.Top="0"
                                Classes="closeButton"
                                Width="42" Height="86"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Cursor="Hand"
                                Command="{Binding CancelEditNicknameCommand}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Canvas Width="42" Height="86">
                                        <Path x:Name="PART_Bg"
                                              Fill="Transparent"
                                              Data="M6 0L6 50L42 86L42 0Z"/>
                                        <Path x:Name="PART_Icon"
                                              Fill="#B2BEBCEA"
                                              Data="M18.4 31L17 29.6L22.6 24L17 18.4L18.4 17L24 22.6L29.6 17L31 18.4L25.4 24L31 29.6L29.6 31L24 25.4L18.4 31Z"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Canvas>

                </Grid>
            </Grid>
        </Panel>
    </Popup>

    <Popup IsOpen="{Binding IsEditEmailOpen}"
           Placement="AnchorAndGravity"
           PlacementTarget="{Binding $parent[Window]}"
           PlacementAnchor="TopLeft"
           PlacementGravity="BottomRight"
           HorizontalOffset="0"
           VerticalOffset="0"
           OverlayInputPassThroughElement="{Binding $parent[Window]}"
           x:CompileBindings="False">
        <Panel Width="{Binding $parent[Window].Bounds.Width}"
               Height="{Binding $parent[Window].Bounds.Height}"
               Background="#BF0D0737"
               DataContext="{Binding}">
            <Grid Width="620" Height="308" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Background shapes (308) -->
                <Canvas Width="620" Height="308">
                    <Path Fill="#CC000000" Data="M0 21.306L21.477 0L36 0L42 0V21.306H0Z"/>
                    <Rectangle Canvas.Left="0" Canvas.Top="21.306" Width="42" Height="198.793" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M22.591 294.598L22.591 242.677L0 220.099H42V308H36L22.591 294.598Z"/>
                    <Rectangle Canvas.Left="42" Canvas.Top="0" Width="536" Height="308" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M584 0L584 50L620 86L620 0Z"/>
                    <Path Fill="#CC000000" Data="M578 95.367L578 54L620 95.357L578 95.367Z"/>
                    <Rectangle Canvas.Left="578" Canvas.Top="95.367" Width="42" Height="191.318" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M620 286.686L598.354 308H578L578.001 286.686H620Z"/>
                </Canvas>

                <!-- Content -->
                <Grid ColumnDefinitions="42,536,42">

                    <StackPanel Grid.Column="1" Margin="0,36,0,0">
                        <TextBlock Text="{DynamicResource ProfileView_EditEmail_Title}"
                                   FontFamily="{DynamicResource AppPixelFont}"
                                   FontWeight="250"
                                   FontStyle="Normal"
                                   FontSize="28"
                                   LineHeight="28"
                                   LetterSpacing="0"
                                   Foreground="White"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource ProfileView_EditEmail_Subtitle}"
                                   FontFamily="Segoe UI"
                                   FontWeight="400"
                                   FontStyle="Normal"
                                   FontSize="16"
                                   LineHeight="24"
                                   LetterSpacing="0"
                                   Foreground="#B2BEBCEA"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <Border Classes="nicknameField"
                                Classes.error="{Binding HasEditEmailError}"
                                BorderThickness="1" Height="55" Margin="0,32,0,0">
                            <Grid ColumnDefinitions="53,*">
                                <Path Grid.Column="0"
                                      Width="20" Height="16" Stretch="Uniform"
                                      Fill="#80BEBCEA"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="19,0,0,0"
                                      Data="M2 16C1.45 16 0.979167 15.8042 0.5875 15.4125C0.195833 15.0208 0 14.55 0 14V2C0 1.45 0.195833 0.979167 0.5875 0.5875C0.979167 0.195833 1.45 0 2 0H18C18.55 0 19.0208 0.195833 19.4125 0.5875C19.8042 0.979167 20 1.45 20 2V14C20 14.55 19.8042 15.0208 19.4125 15.4125C19.0208 15.8042 18.55 16 18 16H2ZM10 9L2 4V14H18V4L10 9ZM10 7L18 2H2L10 7ZM2 4V2V14V4Z"/>
                                <TextBox x:Name="EmailTextBox"
                                         Grid.Column="1"
                                         Classes="profileField"
                                         Text="{Binding EditEmailText}"
                                         PlaceholderText="{DynamicResource ProfileView_EditEmail_Placeholder}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding EditEmailError}"
                                   IsVisible="{Binding EditEmailError, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FF383C"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,28,0,0">
                            <!-- Auto width + side padding — see the nickname dialog's buttons. -->
                            <Button Classes="secondaryButton"
                                    Command="{Binding CancelEditEmailCommand}"
                                    Content="{DynamicResource Button_Cancel}"
                                    Padding="16,0" Height="39"
                                    FontSize="18" FontWeight="250"/>
                            <!-- Disabled until the address actually differs from the current one
                                 (ConfirmEditEmailCommand.CanExecute -> HasEmailChange): the field
                                 opens pre-filled, so there is nothing to confirm yet. -->
                            <Button Classes="primaryButton"
                                    Command="{Binding ConfirmEditEmailCommand}"
                                    Content="{DynamicResource Button_Confirm}"
                                    Padding="16,0" Height="40"
                                    FontSize="18" FontWeight="250"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right sidebar close button -->
                    <Canvas Grid.Column="2" Width="42" VerticalAlignment="Top">
                        <Button Canvas.Left="0" Canvas.Top="0"
                                Classes="closeButton"
                                Width="42" Height="86"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Cursor="Hand"
                                Command="{Binding CancelEditEmailCommand}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Canvas Width="42" Height="86">
                                        <Path x:Name="PART_Bg"
                                              Fill="Transparent"
                                              Data="M6 0L6 50L42 86L42 0Z"/>
                                        <Path x:Name="PART_Icon"
                                              Fill="#B2BEBCEA"
                                              Data="M18.4 31L17 29.6L22.6 24L17 18.4L18.4 17L24 22.6L29.6 17L31 18.4L25.4 24L31 29.6L29.6 31L24 25.4L18.4 31Z"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Canvas>

                </Grid>
            </Grid>
        </Panel>
    </Popup>

    <!-- ══ Delete account confirmation popup (v1.7 §12) ══ -->
    <Popup IsOpen="{Binding IsDeleteAccountOpen}"
           Placement="AnchorAndGravity"
           PlacementTarget="{Binding $parent[Window]}"
           PlacementAnchor="TopLeft"
           PlacementGravity="BottomRight"
           HorizontalOffset="0"
           VerticalOffset="0"
           OverlayInputPassThroughElement="{Binding $parent[Window]}"
           x:CompileBindings="False">
        <Panel Width="{Binding $parent[Window].Bounds.Width}"
               Height="{Binding $parent[Window].Bounds.Height}"
               Background="#BF0D0737"
               DataContext="{Binding}">
            <Grid Width="620" Height="308" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Canvas Width="620" Height="308">
                    <Path Fill="#CC000000" Data="M0 21.306L21.477 0L36 0L42 0V21.306H0Z"/>
                    <Rectangle Canvas.Left="0" Canvas.Top="21.306" Width="42" Height="198.793" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M22.591 294.598L22.591 242.677L0 220.099H42V308H36L22.591 294.598Z"/>
                    <Rectangle Canvas.Left="42" Canvas.Top="0" Width="536" Height="308" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M584 0L584 50L620 86L620 0Z"/>
                    <Path Fill="#CC000000" Data="M578 95.367L578 54L620 95.357L578 95.367Z"/>
                    <Rectangle Canvas.Left="578" Canvas.Top="95.367" Width="42" Height="191.318" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M620 286.686L598.354 308H578L578.001 286.686H620Z"/>
                </Canvas>

                <Grid ColumnDefinitions="42,536,42">
                    <StackPanel Grid.Column="1" Margin="0,36,0,0">
                        <TextBlock Text="{DynamicResource ProfileView_DeleteAccount_Title}"
                                   FontFamily="{DynamicResource AppPixelFont}"
                                   FontWeight="250"
                                   FontSize="28"
                                   LineHeight="28"
                                   Foreground="White"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource ProfileView_DeleteAccount_Subtitle}"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   LineHeight="24"
                                   Foreground="#B2BEBCEA"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Border Classes="nicknameField"
                                BorderThickness="1" Height="55" Margin="0,24,0,0">
                            <Grid ColumnDefinitions="53,*">
                                <Path Grid.Column="0"
                                      Width="16" Height="21" Stretch="Uniform"
                                      Fill="#80BEBCEA"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="19,0,0,0"
                                      Data="M18 30C17.45 30 16.9792 29.8042 16.5875 29.4125C16.1958 29.0208 16 28.55 16 28V18C16 17.45 16.1958 16.9792 16.5875 16.5875C16.9792 16.1958 17.45 16 18 16H19V14C19 12.6167 19.4875 11.4375 20.4625 10.4625C21.4375 9.4875 22.6167 9 24 9C25.3833 9 26.5625 9.4875 27.5375 10.4625C28.5125 11.4375 29 12.6167 29 14V16H30C30.55 16 31.0208 16.1958 31.4125 16.5875C31.8042 16.9792 32 17.45 32 18V28C32 28.55 31.8042 29.0208 31.4125 29.4125C31.0208 29.8042 30.55 30 30 30H18ZM18 28H30V18H18V28ZM25.4125 24.4125C25.8042 24.0208 26 23.55 26 23C26 22.45 25.8042 21.9792 25.4125 21.5875C25.0208 21.1958 24.55 21 24 21C23.45 21 22.9792 21.1958 22.5875 21.5875C22.1958 21.9792 22 22.45 22 23C22 23.55 22.1958 24.0208 22.5875 24.4125C22.9792 24.8042 23.45 25 24 25C24.55 25 25.0208 24.8042 25.4125 24.4125ZM21 16H27V14C27 13.1667 26.7083 12.4583 26.125 11.875C25.5417 11.2917 24.8333 11 24 11C23.1667 11 22.4583 11.2917 21.875 11.875C21.2917 12.4583 21 13.1667 21 14V16Z"/>
                                <TextBox x:Name="DeleteAccountPasswordTextBox"
                                         Grid.Column="1"
                                         Classes="profileField"
                                         PasswordChar="•"
                                         Text="{Binding DeleteAccountPassword}"
                                         PlaceholderText="{DynamicResource ProfileView_DeleteAccount_PasswordPlaceholder}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding DeleteAccountError}"
                                   IsVisible="{Binding DeleteAccountError, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#FF383C"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,28,0,0">
                            <!-- Auto width + side padding — see the nickname dialog's buttons. -->
                            <Button Classes="secondaryButton"
                                    Command="{Binding CancelDeleteAccountCommand}"
                                    Content="{DynamicResource Button_Cancel}"
                                    Padding="16,0" Height="39"
                                    FontSize="18" FontWeight="250"/>
                            <Button Classes="primaryButton"
                                    Command="{Binding ConfirmDeleteAccountCommand}"
                                    Content="{DynamicResource ProfileView_DeleteAccount_Confirm}"
                                    Padding="16,0" Height="40"
                                    FontSize="18" FontWeight="250"/>
                        </StackPanel>
                    </StackPanel>

                    <Canvas Grid.Column="2">
                        <Button Canvas.Left="0" Canvas.Top="0"
                                Classes="closeButton"
                                Width="42" Height="86"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Cursor="Hand"
                                Command="{Binding CancelDeleteAccountCommand}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Canvas Width="42" Height="86">
                                        <Path x:Name="PART_Bg"
                                              Fill="Transparent"
                                              Data="M6 0L6 50L42 86L42 0Z"/>
                                        <Path x:Name="PART_Icon"
                                              Fill="#B2BEBCEA"
                                              Data="M18.4 31L17 29.6L22.6 24L17 18.4L18.4 17L24 22.6L29.6 17L31 18.4L25.4 24L31 29.6L29.6 31L24 25.4L18.4 31Z"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Canvas>
                </Grid>
            </Grid>
        </Panel>
    </Popup>

    <!-- ══ Change password dialog (v1.7 §11 revised flow — same as forgot password) ══ -->
    <Popup IsOpen="{Binding IsChangePasswordOpen}"
           Placement="AnchorAndGravity"
           PlacementTarget="{Binding $parent[Window]}"
           PlacementAnchor="TopLeft"
           PlacementGravity="BottomRight"
           HorizontalOffset="0"
           VerticalOffset="0"
           OverlayInputPassThroughElement="{Binding $parent[Window]}"
           x:CompileBindings="False">
        <Panel Width="{Binding $parent[Window].Bounds.Width}"
               Height="{Binding $parent[Window].Bounds.Height}"
               Background="#BF0D0737"
               DataContext="{Binding}">
            <Grid Width="620" Height="308" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Canvas Width="620" Height="308">
                    <Path Fill="#CC000000" Data="M0 21.306L21.477 0L36 0L42 0V21.306H0Z"/>
                    <Rectangle Canvas.Left="0" Canvas.Top="21.306" Width="42" Height="198.793" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M22.591 294.598L22.591 242.677L0 220.099H42V308H36L22.591 294.598Z"/>
                    <Rectangle Canvas.Left="42" Canvas.Top="0" Width="536" Height="308" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M584 0L584 50L620 86L620 0Z"/>
                    <Path Fill="#CC000000" Data="M578 95.367L578 54L620 95.357L578 95.367Z"/>
                    <Rectangle Canvas.Left="578" Canvas.Top="95.367" Width="42" Height="191.318" Fill="#CC000000"/>
                    <Path Fill="#CC000000" Data="M620 286.686L598.354 308H578L578.001 286.686H620Z"/>
                </Canvas>

                <Grid ColumnDefinitions="42,536,42">
                    <StackPanel Grid.Column="1" Margin="0,36,0,0">
                        <TextBlock Text="{DynamicResource ProfileView_ChangePassword_Title}"
                                   FontFamily="{DynamicResource AppPixelFont}"
                                   FontWeight="250"
                                   FontSize="28"
                                   LineHeight="28"
                                   Foreground="White"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource ProfileView_ChangePassword_Subtitle}"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   LineHeight="24"
                                   Foreground="#B2BEBCEA"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Border Classes="nicknameField"
                                Classes.error="{Binding ChangePasswordEmailError}"
                                BorderThickness="1" Height="55" Margin="0,24,0,0">
                            <Grid ColumnDefinitions="53,*">
                                <Path Grid.Column="0"
                                      Width="20" Height="16" Stretch="Uniform"
                                      Fill="#80BEBCEA"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="19,0,0,0"
                                      Data="M2 16C1.45 16 0.979167 15.8042 0.5875 15.4125C0.195833 15.0208 0 14.55 0 14V2C0 1.45 0.195833 0.979167 0.5875 0.5875C0.979167 0.195833 1.45 0 2 0H18C18.55 0 19.0208 0.195833 19.4125 0.5875C19.8042 0.979167 20 1.45 20 2V14C20 14.55 19.8042 15.0208 19.4125 15.4125C19.0208 15.8042 18.55 16 18 16H2ZM10 9L2 4V14H18V4L10 9ZM10 7L18 2H2L10 7ZM2 4V2V14V4Z"/>
                                <!-- Fully inert: the dialog only CONFIRMS the account's address (the
                                     reset link can go nowhere else), so the field takes no focus, caret
                                     or clicks at all. Not IsEnabled="False" — the disabled style would
                                     dim the address, and it must stay readable. -->
                                <TextBox x:Name="ChangePasswordEmailTextBox"
                                         Grid.Column="1"
                                         Classes="profileField"
                                         IsReadOnly="True"
                                         Focusable="False"
                                         IsHitTestVisible="False"
                                         Text="{Binding ChangePasswordEmail}"
                                         PlaceholderText="{DynamicResource ProfileView_EditEmail_Placeholder}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource WelcomeView_Error_Email}"
                                   IsVisible="{Binding ChangePasswordEmailError}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FF383C"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding ChangePasswordApiError}"
                                   IsVisible="{Binding ChangePasswordApiError, Converter={x:Static avaConverters:StringConverters.IsNotNullOrEmpty}}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FF383C"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,28,0,0">
                            <!-- Auto width + side padding — see the nickname dialog's buttons. -->
                            <Button Classes="secondaryButton"
                                    Command="{Binding CancelChangePasswordCommand}"
                                    Content="{DynamicResource Button_Cancel}"
                                    Padding="16,0" Height="39"
                                    FontSize="18" FontWeight="250"/>
                            <Button Classes="primaryButton"
                                    Command="{Binding SendChangePasswordResetCommand}"
                                    Content="{DynamicResource ProfileView_ChangePassword_Send}"
                                    Padding="16,0" Height="40"
                                    FontSize="18" FontWeight="250"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right sidebar close button -->
                    <Canvas Grid.Column="2">
                        <Button Canvas.Left="0" Canvas.Top="0"
                                Classes="closeButton"
                                Width="42" Height="86"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Cursor="Hand"
                                Command="{Binding CancelChangePasswordCommand}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Canvas Width="42" Height="86">
                                        <Path x:Name="PART_Bg"
                                              Fill="Transparent"
                                              Data="M6 0L6 50L42 86L42 0Z"/>
                                        <Path x:Name="PART_Icon"
                                              Fill="#B2BEBCEA"
                                              Data="M18.4 31L17 29.6L22.6 24L17 18.4L18.4 17L24 22.6L29.6 17L31 18.4L25.4 24L31 29.6L29.6 31L24 25.4L18.4 31Z"/>
                                    </Canvas>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Canvas>
                </Grid>
            </Grid>
        </Panel>
    </Popup>

    </Panel>

</UserControl>
