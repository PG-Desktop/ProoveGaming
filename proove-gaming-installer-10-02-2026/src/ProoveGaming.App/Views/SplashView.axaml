<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProoveGaming.App.Views.SplashView"
             Background="Transparent">

  <Grid ClipToBounds="True">
    <!-- Background gradient -->
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#070614" Offset="0.0"/>
        <GradientStop Color="#0B0A1E" Offset="0.35"/>
        <GradientStop Color="#2B0F4D" Offset="0.78"/>
        <GradientStop Color="#120A26" Offset="1.0"/>
      </LinearGradientBrush>
    </Grid.Background>

    <!-- Fluent-ish vignette -->
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.78">
          <GradientStop Color="#00000000" Offset="0.0"/>
          <GradientStop Color="#00000055" Offset="0.65"/>
          <GradientStop Color="#000000B0" Offset="1.0"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <!-- Decorative blurred shapes (placeholders) -->
    <Canvas IsHitTestVisible="False" Opacity="0.20">
      <Path Data="M 0,20 L 55,20 L 55,5 L 90,30 L 55,55 L 55,40 L 0,40 Z"
            Fill="#2C1A52"
            Canvas.Left="1460"
            Canvas.Top="120">
        <Path.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="8"/>
            <ScaleTransform ScaleX="2.0" ScaleY="2.0"/>
          </TransformGroup>
        </Path.RenderTransform>
      </Path>

      <Ellipse Width="92" Height="92"
               Stroke="#2C1A52" StrokeThickness="14"
               Canvas.Left="170" Canvas.Top="560"/>
      <Path Data="M 0,0 L 86,86 M 86,0 L 0,86"
            Stroke="#2C1A52" StrokeThickness="14"
            StrokeLineCap="Round"
            Canvas.Left="110" Canvas.Top="680"/>

      <Path Data="M 0,80 L 70,0 L 140,80 Z"
            Fill="#2C1A52"
            Canvas.Left="1550"
            Canvas.Top="860">
        <Path.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="-10"/>
            <ScaleTransform ScaleX="2.1" ScaleY="2.1"/>
          </TransformGroup>
        </Path.RenderTransform>
      </Path>
    </Canvas>

    <!-- Center content -->
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                Margin="0,0,0,20">

      <!-- Replace with your real logo -->
      <!--
      <Image Source="avares://ProoveGaming/Assets/proove-logo.png"
             Width="360"
             Stretch="Uniform"
             HorizontalAlignment="Center"/>
      -->

      <!-- Logo placeholder -->
      <Canvas Width="420" Height="180" HorizontalAlignment="Center">
        <Path Fill="#6D63FF"
              Data="M 30,30 H 300 C 340,30 360,60 360,80 H 320
                    C 320,62 305,50 285,50 H 30 Z"/>
        <Path Fill="#6D63FF" Data="M 50,90 H 370 V 115 H 50 Z"/>
        <Path Fill="#6D63FF"
              Data="M 50,90 V 145 C 50,165 65,180 85,180 H 300 V 160 H 95
                    C 85,160 75,152 75,142 V 90 Z"/>
        <Path Fill="#6D63FF"
              Data="M 235,78 C 250,60 270,50 295,50 H 370 V 70 H 300
                    C 285,70 270,78 260,90 Z"
              Opacity="0.95"/>
      </Canvas>

      <TextBlock Text="PROOVE GAMING"
                 HorizontalAlignment="Center"
                 FontSize="24"
                 FontWeight="Light"
                 Foreground="#8B86FF"
                 LetterSpacing="4"/>

      <!-- Fluent control: indeterminate progress -->
      <ProgressBar Width="360"
                   Height="6"
                   IsIndeterminate="True"
                   Foreground="#8B86FF"
                   Background="#2A2440"
                   CornerRadius="3"
                   HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
