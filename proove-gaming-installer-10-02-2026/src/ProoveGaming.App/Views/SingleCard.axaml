
<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:common="clr-namespace:ProoveGaming.Common.Controls;assembly=ProoveGaming.Common"
			 xmlns:viewmodels="using:ProoveGaming.App.ViewModels"
			 xmlns:converters="using:ProoveGaming.App.Converters"
			 xmlns:views="using:ProoveGaming.App.Views"
			 xmlns:cv="using:Avalonia.Data.Converters"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="viewmodels:SingleCardViewModel"
			 Classes.inactive="{Binding !Connected}"
			 Cursor="Hand"
			 x:Class="ProoveGaming.App.SingleCard">
	<UserControl.Resources>
		<!-- Defaults are already 1.0 / 0.3 — the same pair the SVG branch expresses with two controls. -->
		<converters:BoolToOpacityConverter x:Key="CardImageOpacityConverter" />
	</UserControl.Resources>
			 <UserControl.Styles>
		<Style Selector="Button.menuButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#4D6357FF" />
		</Style>
		<Style Selector="Button.deleteButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#4DFF383C" />
		</Style>

		<!-- Background card chrome: slightly darker when disconnected. -->
		<Style Selector="Path.cardBg, Rectangle.cardBg">
			<Setter Property="Fill" Value="#B3000000"/>
		</Style>
		<Style Selector="UserControl.inactive Path.cardBg, UserControl.inactive Rectangle.cardBg">
			<Setter Property="Fill" Value="#CC000000"/>
		</Style>

		<!-- Text colors dim when the card is in the inactive state. -->
		<Style Selector="TextBlock.deviceType">
			<Setter Property="Foreground" Value="#B2BEBCEA"/>
		</Style>
		<Style Selector="UserControl.inactive TextBlock.deviceType">
			<Setter Property="Foreground" Value="#4DBEBCEA"/>
		</Style>

		<Style Selector="TextBlock.deviceName">
			<Setter Property="Foreground" Value="#FFFFFF"/>
		</Style>
		<Style Selector="UserControl.inactive TextBlock.deviceName">
			<Setter Property="Foreground" Value="#66FFFFFF"/>
		</Style>

		<!-- Dots-overlay sizing: shrinks when inactive (only Delete menu item left). -->
		<Style Selector="Grid.dotsOverlay, Canvas.dotsOverlay, Rectangle.dotsOverlay">
			<Setter Property="Height" Value="136"/>
		</Style>
		<Style Selector="UserControl.inactive Grid.dotsOverlay,
		                 UserControl.inactive Canvas.dotsOverlay,
		                 UserControl.inactive Rectangle.dotsOverlay">
			<Setter Property="Height" Value="64"/>
		</Style>

		<Style Selector="Rectangle.dotsOverlaySide">
			<Setter Property="Height" Value="120"/>
		</Style>
		<Style Selector="UserControl.inactive Rectangle.dotsOverlaySide">
			<Setter Property="Height" Value="48"/>
		</Style>

		<Style Selector="Path.dotsOverlayCorner">
			<Setter Property="Data" Value="M16 136 L0 120 L16 120 Z"/>
		</Style>
		<Style Selector="UserControl.inactive Path.dotsOverlayCorner">
			<Setter Property="Data" Value="M16 64 L0 48 L16 48 Z"/>
		</Style>
	</UserControl.Styles>
	<!-- 336 wide: four mouse cards plus the 16px gaps fill the default window's 1392px row
		 exactly (336*4+16*3 = 1392), and 336+16+336 pairs with the 688 DoubleCard. This is
		 the design's original 336 geometry (previously 314 with the right-edge group
		 shifted left by 22).
		 The hover-lift transition lives on this root element, not the UserControl:
		 DeviceCardBase lifts the CONTENT so the control's hit-area stays put — see its
		 constructor note (the jitter fix). -->
	<Panel Width="336" Height="324" Background="Transparent">
		<Panel.Transitions>
			<Transitions>
				<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
			</Transitions>
		</Panel.Transitions>

		<!-- Background -->
		<Canvas Width="336" Height="324">

			<Path Classes="cardBg"
				  Data="M0 21.306L21.4766 0L36 5.90786e-07L42 0V21.306H0Z"/>

			<Rectangle Classes="cardBg"
				   Canvas.Left="0"
				   Canvas.Top="21.3057"
				   Width="42"
				   Height="214.792"/>

			<Path Classes="cardBg"
				  Data="M22.5906 310.598L22.5906 258.677L0 236.099H42V324H36L22.5906 310.598Z"/>

			<Path Classes="cardBg"
				  Data="M0 245L17 261.999L17 305.237L0 288.237L0 245Z"/>

			<Rectangle Classes="cardBg"
					   Canvas.Left="42"
					   Canvas.Top="0"
					   Width="252"
					   Height="324"/>

			<Path Classes="cardBg"
				  Data="M300 0L300 50L336 86L336 0.000347503L300 0Z"/>

			<Path Fill="#6357FF"
				  Data="M315.334 28C315.334 26.5272 316.528 25.3333 318.001 25.3333C319.473 25.3333 320.667 26.5272 320.667 28C320.667 29.4728 319.473 30.6667 318.001 30.6667C316.528 30.6667 315.334 29.4728 315.334 28Z"/>

			<Path Fill="#6357FF"
				  Data="M315.334 18.6667C315.334 17.1939 316.528 16 318.001 16C319.473 16 320.667 17.1939 320.667 18.6667C320.667 20.1394 319.473 21.3333 318.001 21.3333C316.528 21.3333 315.334 20.1394 315.334 18.6667Z"/>

			<Path Fill="#6357FF"
				  Data="M315.334 37.3333C315.334 35.8606 316.528 34.6667 318.001 34.6667C319.473 34.6667 320.667 35.8606 320.667 37.3333C320.667 38.8061 319.473 40 318.001 40C316.528 40 315.334 38.8061 315.334 37.3333Z"/>

			<Path Classes="cardBg"
				  Data="M294 95.3673L294 54L336 95.3567L294 95.3673Z"/>

			<Rectangle Classes="cardBg"
					   Canvas.Left="294"
					   Canvas.Top="95.3672"
					   Width="42"
					   Height="207.318"/>

			<Path Classes="cardBg"
				  Data="M336 302.686L314.354 324H294L294.001 302.686H336Z"/>

		</Canvas>

		<Grid ColumnDefinitions="42, *, 42">

			<Grid Grid.Column="0">

			</Grid>

			<Grid Grid.Column="1">
				<Border Padding="0 40 0 0">
					<StackPanel>

						<Grid Width="240" Height="169.33" HorizontalAlignment="Center">
							<common:SvgImageView SourceUri="{Binding ImageUri}"
												 IsVisible="{Binding Connected}"/>
							<common:SvgImageView SourceUri="{Binding ImageUri}"
												 IsVisible="{Binding !Connected}"
												 Opacity="0.3"/>
							<!-- Raster artwork (Cosmo ships a PNG). SvgImageView renders nothing for a
								 raster file, so a bitmap branch is what keeps the card from appearing
								 empty. The disconnected 0.3 opacity above is expressed here through the
								 converter's own defaults rather than a second control. -->
							<!-- ImageScale compensates for padding baked into the asset, the same job it
								 already does on the details page. The headset PNGs carry a wide transparent
								 margin (Cosmo's artwork is 82% x 71% of its canvas) and Cosmo's canvas is
								 nearly square inside this landscape box, so Uniform fitted the PADDING and
								 the headset rendered at ~57% of the card width while the SVG devices fill
								 it. RenderTransform, not Width/Height, so the scale is purely visual and
								 the surrounding layout does not move.

								 Deliberately on the raster branch only: raster means the headsets today,
								 and the SVG cards are correctly framed already — scaling them would be an
								 unrequested change to every other device.

								 The origin MUST be written as percentages. RenderTransformOrigin is a
								 RelativePoint, and Avalonia parses bare numbers as ABSOLUTE pixels — so
								 "0.5,0.5" anchors the scale half a pixel from the top-left corner and the
								 image visibly grows down and to the right instead of outward from its
								 centre. Only "50%,50%" is the centre. -->
							<Image Source="{Binding ImageUri, Converter={x:Static converters:UriToBitmapConverter.Instance}}"
								   IsVisible="{Binding IsRasterImage}"
								   Opacity="{Binding Connected, Converter={StaticResource CardImageOpacityConverter}}"
								   Stretch="Uniform"
								   RenderTransformOrigin="50%,50%"
								   RenderOptions.BitmapInterpolationMode="HighQuality">
								<Image.RenderTransform>
									<ScaleTransform ScaleX="{Binding ImageScale}" ScaleY="{Binding ImageScale}" />
								</Image.RenderTransform>
							</Image>
						</Grid>

						<Border Padding="0, 15, 0, 10">
							<StackPanel Spacing="5">
								<TextBlock
									Classes="deviceType"
									Width="252"
									Text="{Binding DeviceTypeLabel, Converter={x:Static converters:DeviceTypeLabelConverter.Instance}}"
									TextAlignment="Center"
									FontFamily="avares://ProoveGaming.Common/Assets/Fonts#Pixel Font7"
									FontStyle="Normal"
									FontSize="14"
									LineHeight="14"/>

								<TextBlock
									Classes="deviceName"
									Width="252"
									Text="{Binding DisplayName, Converter={x:Static converters:StringToUpperConverter.Instance}}"
									TextAlignment="Center"
									FontFamily="avares://ProoveGaming.Common/Assets/Fonts#Pixel Font7"
									FontStyle="Normal"
									FontSize="16"
									LineHeight="18"/>
							</StackPanel>
						</Border>

						<!-- Status row (transports / audio mute / battery / NO CONNECTION),
							 extracted verbatim into the shared CardStatusRowView so DoubleCard
							 centers the same way instead of drifting on fixed coordinates. -->
						<views:CardStatusRowView />

					</StackPanel>
				</Border>
			</Grid>

		</Grid>

		<!-- MinWidth, never a fixed Width: the menu rows carry localized text, so the overlay
			 takes its width from the widest row ("Змінити профіль" outgrew the en-sized 204)
			 and 204 only floors it to the design size.
			 Hangs off the card root, NOT inside the content grid's 42px right column: that
			 column's measure constraint collapses the natural width back to the 204 floor,
			 so the widest row overhung the background. DoubleCard hosts it at the root for
			 the same reason. -->
		<Grid
		  x:Name="DotsOverlay"
		  Classes="dotsOverlay"
		  MinWidth="204"
		  HorizontalAlignment="Right"
		  VerticalAlignment="Top"
		  Margin="0,60,20,0"
		  IsVisible="False">

		<Grid.Effect>
			<DropShadowEffect BlurRadius="40" Color="#6357FF" Opacity="0.3"/>
		</Grid.Effect>

		<!-- Background shape: 16px chamfer columns + a stretching middle, following the
			 natural width. -->
		<Grid Classes="dotsOverlay" ColumnDefinitions="16,*,16">
			<Rectangle Classes="dotsOverlaySide" VerticalAlignment="Top" Fill="Black"/>
			<Path Classes="dotsOverlayCorner" Fill="Black"/>
			<Rectangle Grid.Column="1" Classes="dotsOverlay" Fill="Black"/>
			<Path Grid.Column="2" Fill="Black" Data="M0 0 L16 16 L0 16 Z"/>
			<Rectangle Grid.Column="2" Classes="dotsOverlaySide" VerticalAlignment="Top" Margin="0,16,0,0" Fill="Black"/>
		</Grid>

		<StackPanel Margin="22,8,24,0" Spacing="0" VerticalAlignment="Top">

			<Button Classes="menuButton" Background="Transparent" BorderThickness="0"
					Padding="12,0,12,0" Height="40" HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Left" Command="{Binding SwitchProfileCommand}"
					IsVisible="{Binding Connected}">
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Viewbox Width="22" Height="16">
						<Canvas Width="22" Height="16">
							<Path Fill="#BEBCEA" Opacity="0.7">
								<Path.RenderTransform><TranslateTransform X="-65" Y="-60"/></Path.RenderTransform>
								<Path.Data>M68.7258 76C67.7258 76 66.8716 75.6417 66.1633 74.925C65.4549 74.2083 65.0841 73.3417 65.0508 72.325C65.0508 72.175 65.0591 72.025 65.0758 71.875C65.0924 71.725 65.1174 71.575 65.1508 71.425L67.2508 63.025C67.4841 62.125 67.9591 61.3958 68.6758 60.8375C69.3924 60.2792 70.2091 60 71.1258 60H80.8758C81.7924 60 82.6091 60.2792 83.3258 60.8375C84.0424 61.3958 84.5175 62.125 84.7508 63.025L86.8508 71.425C86.8841 71.575 86.9133 71.7292 86.9383 71.8875C86.9633 72.0458 86.9758 72.2 86.9758 72.35C86.9758 73.3667 86.6133 74.2292 85.8883 74.9375C85.1633 75.6458 84.2924 76 83.2758 76C82.5758 76 81.9258 75.8167 81.3258 75.45C80.7258 75.0833 80.2758 74.5833 79.9758 73.95L79.2758 72.5C79.1924 72.3333 79.0674 72.2083 78.9008 72.125C78.7341 72.0417 78.5591 72 78.3758 72H73.6258C73.4424 72 73.2674 72.0417 73.1008 72.125C72.9341 72.2083 72.8091 72.3333 72.7258 72.5L72.0258 73.95C71.7258 74.5833 71.2758 75.0833 70.6758 75.45C70.0758 75.8167 69.4258 76 68.7258 76ZM68.8008 74C69.1174 74 69.4049 73.9167 69.6633 73.75C69.9216 73.5833 70.1174 73.3583 70.2508 73.075L70.9508 71.65C71.2008 71.1333 71.5674 70.7292 72.0508 70.4375C72.5341 70.1458 73.0591 70 73.6258 70H78.3758C78.9424 70 79.4674 70.15 79.9508 70.45C80.4341 70.75 80.8091 71.15 81.0758 71.65L81.7758 73.075C81.9091 73.3583 82.1049 73.5833 82.3633 73.75C82.6216 73.9167 82.9091 74 83.2258 74C83.6924 74 84.0924 73.8458 84.4258 73.5375C84.7591 73.2292 84.9341 72.8417 84.9508 72.375C84.9508 72.3917 84.9341 72.2333 84.9008 71.9L82.8008 63.525C82.6841 63.075 82.4508 62.7083 82.1008 62.425C81.7508 62.1417 81.3424 62 80.8758 62H71.1258C70.6591 62 70.2466 62.1417 69.8883 62.425C69.5299 62.7083 69.3008 63.075 69.2008 63.525L67.1008 71.9C67.0674 72 67.0508 72.15 67.0508 72.35C67.0508 72.8167 67.2216 73.2083 67.5633 73.525C67.9049 73.8417 68.3174 74 68.8008 74ZM78.2133 66.7125C78.4049 66.5208 78.5008 66.2833 78.5008 66C78.5008 65.7167 78.4049 65.4792 78.2133 65.2875C78.0216 65.0958 77.7841 65 77.5008 65C77.2174 65 76.9799 65.0958 76.7883 65.2875C76.5966 65.4792 76.5008 65.7167 76.5008 66C76.5008 66.2833 76.5966 66.5208 76.7883 66.7125C76.9799 66.9042 77.2174 67 77.5008 67C77.7841 67 78.0216 66.9042 78.2133 66.7125ZM80.2133 64.7125C80.4049 64.5208 80.5008 64.2833 80.5008 64C80.5008 63.7167 80.4049 63.4792 80.2133 63.2875C80.0216 63.0958 79.7841 63 79.5008 63C79.2174 63 78.9799 63.0958 78.7883 63.2875C78.5966 63.4792 78.5008 63.7167 78.5008 64C78.5008 64.2833 78.5966 64.5208 78.7883 64.7125C78.9799 64.9042 79.2174 65 79.5008 65C79.7841 65 80.0216 64.9042 80.2133 64.7125ZM80.2133 68.7125C80.4049 68.5208 80.5008 68.2833 80.5008 68C80.5008 67.7167 80.4049 67.4792 80.2133 67.2875C80.0216 67.0958 79.7841 67 79.5008 67C79.2174 67 78.9799 67.0958 78.7883 67.2875C78.5966 67.4792 78.5008 67.7167 78.5008 68C78.5008 68.2833 78.5966 68.5208 78.7883 68.7125C78.9799 68.9042 79.2174 69 79.5008 69C79.7841 69 80.0216 68.9042 80.2133 68.7125ZM82.2133 66.7125C82.4049 66.5208 82.5008 66.2833 82.5008 66C82.5008 65.7167 82.4049 65.4792 82.2133 65.2875C82.0216 65.0958 81.7841 65 81.5008 65C81.2174 65 80.9799 65.0958 80.7883 65.2875C80.5966 65.4792 80.5008 65.7167 80.5008 66C80.5008 66.2833 80.5966 66.5208 80.7883 66.7125C80.9799 66.9042 81.2174 67 81.5008 67C81.7841 67 82.0216 66.9042 82.2133 66.7125ZM73.0383 68.2875C73.1799 68.1458 73.2508 67.9667 73.2508 67.75V66.75H74.2508C74.4674 66.75 74.6466 66.6792 74.7883 66.5375C74.9299 66.3958 75.0008 66.2167 75.0008 66C75.0008 65.7833 74.9299 65.6042 74.7883 65.4625C74.6466 65.3208 74.4674 65.25 74.2508 65.25H73.2508V64.25C73.2508 64.0333 73.1799 63.8542 73.0383 63.7125C72.8966 63.5708 72.7174 63.5 72.5008 63.5C72.2841 63.5 72.1049 63.5708 71.9633 63.7125C71.8216 63.8542 71.7508 64.0333 71.7508 64.25V65.25H70.7508C70.5341 65.25 70.3549 65.3208 70.2133 65.4625C70.0716 65.6042 70.0008 65.7833 70.0008 66C70.0008 66.2167 70.0716 66.3958 70.2133 66.5375C70.3549 66.6792 70.5341 66.75 70.7508 66.75H71.7508V67.75C71.7508 67.9667 71.8216 68.1458 71.9633 68.2875C72.1049 68.4292 72.2841 68.5 72.5008 68.5C72.7174 68.5 72.8966 68.4292 73.0383 68.2875Z</Path.Data>
							</Path>
						</Canvas>
					</Viewbox>
					<TextBlock Text="{DynamicResource HomeView_CardMenu_SwitchProfile}" Foreground="White" FontSize="16" FontFamily="{DynamicResource BaseAppFont}" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="menuButton" Background="Transparent" BorderThickness="0"
					Padding="12,0,12,0" Height="40" HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}"
					IsVisible="{Binding Connected}">
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Viewbox Width="22" Height="20">
						<Canvas Width="22" Height="20">
							<Path Fill="#BEBCEA" Opacity="0.7">
								<Path.RenderTransform><TranslateTransform X="-65" Y="-98"/></Path.RenderTransform>
								<Path.Data>M73.2492 118L72.8492 114.8C72.6326 114.717 72.4284 114.617 72.2367 114.5C72.0451 114.383 71.8576 114.258 71.6742 114.125L68.6992 115.375L65.9492 110.625L68.5242 108.675C68.5076 108.558 68.4992 108.446 68.4992 108.338V107.663C68.4992 107.554 68.5076 107.442 68.5242 107.325L65.9492 105.375L68.6992 100.625L71.6742 101.875C71.8576 101.742 72.0492 101.617 72.2492 101.5C72.4492 101.383 72.6492 101.283 72.8492 101.2L73.2492 98H78.7492L79.1492 101.2C79.3659 101.283 79.5701 101.383 79.7617 101.5C79.9534 101.617 80.1409 101.742 80.3242 101.875L83.2992 100.625L86.0492 105.375L83.4742 107.325C83.4909 107.442 83.4992 107.554 83.4992 107.663V108.338C83.4992 108.446 83.4826 108.558 83.4492 108.675L86.0242 110.625L83.2742 115.375L80.3242 114.125C80.1409 114.258 79.9492 114.383 79.7492 114.5C79.5492 114.617 79.3492 114.717 79.1492 114.8L78.7492 118H73.2492ZM74.9992 116H76.9742L77.3242 113.35C77.8409 113.217 78.3201 113.021 78.7617 112.762C79.2034 112.504 79.6076 112.192 79.9742 111.825L82.4492 112.85L83.4242 111.15L81.2742 109.525C81.3576 109.292 81.4159 109.046 81.4492 108.788C81.4826 108.529 81.4992 108.267 81.4992 108C81.4992 107.733 81.4826 107.471 81.4492 107.213C81.4159 106.954 81.3576 106.708 81.2742 106.475L83.4242 104.85L82.4492 103.15L79.9742 104.2C79.6076 103.817 79.2034 103.496 78.7617 103.238C78.3201 102.979 77.8409 102.783 77.3242 102.65L76.9992 100H75.0242L74.6742 102.65C74.1576 102.783 73.6784 102.979 73.2367 103.238C72.7951 103.496 72.3909 103.808 72.0242 104.175L69.5492 103.15L68.5742 104.85L70.7242 106.45C70.6409 106.7 70.5826 106.95 70.5492 107.2C70.5159 107.45 70.4992 107.717 70.4992 108C70.4992 108.267 70.5159 108.525 70.5492 108.775C70.5826 109.025 70.6409 109.275 70.7242 109.525L68.5742 111.15L69.5492 112.85L72.0242 111.8C72.3909 112.183 72.7951 112.504 73.2367 112.762C73.6784 113.021 74.1576 113.217 74.6742 113.35L74.9992 116ZM76.0492 111.5C77.0159 111.5 77.8409 111.158 78.5242 110.475C79.2076 109.792 79.5492 108.967 79.5492 108C79.5492 107.033 79.2076 106.208 78.5242 105.525C77.8409 104.842 77.0159 104.5 76.0492 104.5C75.0659 104.5 74.2367 104.842 73.5617 105.525C72.8867 106.208 72.5492 107.033 72.5492 108C72.5492 108.967 72.8867 109.792 73.5617 110.475C74.2367 111.158 75.0659 111.5 76.0492 111.5Z</Path.Data>
							</Path>
						</Canvas>
					</Viewbox>
					<TextBlock Text="{DynamicResource HomeView_CardMenu_OpenSettings}" Foreground="White" FontSize="16" FontFamily="{DynamicResource BaseAppFont}" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<Button Classes="deleteButton" Background="Transparent" BorderThickness="0"
					Padding="12,0,12,0" Height="40" HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Left" Command="{Binding DeleteCommand}">
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Viewbox Width="22" Height="18">
						<Canvas Width="16" Height="18">
							<Path Fill="#FF383C">
								<Path.RenderTransform><TranslateTransform X="-68" Y="-139"/></Path.RenderTransform>
								<Path.Data>M71 157C70.45 157 69.9792 156.804 69.5875 156.413C69.1958 156.021 69 155.55 69 155V142H68V140H73V139H79V140H84V142H83V155C83 155.55 82.8042 156.021 82.4125 156.413C82.0208 156.804 81.55 157 81 157H71ZM81 142H71V155H81V142ZM73 153H75V144H73V153ZM77 153H79V144H77V153Z</Path.Data>
							</Path>
						</Canvas>
					</Viewbox>
					<TextBlock Text="{DynamicResource HomeView_CardMenu_Delete}" Foreground="#FF383C" FontSize="16" FontFamily="{DynamicResource BaseAppFont}" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

		</StackPanel>
		</Grid>

		<!-- Info icon (only for active state).
		     HIDDEN for now: the firmware-update text it shows is not finished. Kept rather than
		     deleted because it is coming back — flip IsVisible back to {Binding Connected} to
		     restore it, and the InfoTooltip below with it. -->
		<Panel x:Name="InfoIconArea"
			   HorizontalAlignment="Left" VerticalAlignment="Top"
			   Background="Transparent"
			   IsVisible="False">
			<Path Fill="#6357FF"
			  Data="M41 32C41 27.0294 36.9706 23 32 23C27.0294 23 23 27.0294 23 32C23 36.9706 27.0294 41 32 41C36.9706 41 41 36.9706 41 32ZM43 32C43 38.0751 38.0751 43 32 43C25.9249 43 21 38.0751 21 32C21 25.9249 25.9249 21 32 21C38.0751 21 43 25.9249 43 32Z"/>
			<Path Fill="#6357FF"
			  Data="M31 36V32C31 31.4477 31.4477 31 32 31C32.5523 31 33 31.4477 33 32V36C33 36.5523 32.5523 37 32 37C31.4477 37 31 36.5523 31 36Z"/>
			<Path Fill="#6357FF"
			  Data="M32.0098 27C32.5621 27 33.0098 27.4477 33.0098 28C33.0098 28.5523 32.5621 29 32.0098 29H32C31.4477 29 31 28.5523 31 28C31 27.4477 31.4477 27 32 27H32.0098Z"/>
		</Panel>

		<!-- Info tooltip -->
		<Grid x:Name="InfoTooltip"
			  Width="154" Height="44"
			  IsVisible="False"
			  HorizontalAlignment="Left" VerticalAlignment="Top"
			  Margin="10,47,0,0">
			<Grid.Effect>
				<DropShadowEffect BlurRadius="40" Color="#6357FF" Opacity="0.3"/>
			</Grid.Effect>
			<Rectangle Fill="Black"/>
			<StackPanel Margin="12,0,12,0" Spacing="2" VerticalAlignment="Center">
				<TextBlock Text="{Binding FirmwareUpdateText}"
						   Foreground="White"
						   FontSize="12"
						   LineHeight="16"
						   FontFamily="{DynamicResource BaseAppFont}"/>
				<TextBlock Text="{Binding FirmwareUpdateAction}"
						   IsVisible="{Binding FirmwareUpdateAction, Converter={x:Static cv:StringConverters.IsNotNullOrEmpty}}"
						   HorizontalAlignment="Center"
						   Foreground="#6357FF"
						   FontSize="12"
						   LineHeight="16"
						   FontFamily="{DynamicResource BaseAppFont}"/>
			</StackPanel>
		</Grid>

		<Button
			x:Name="DotsButton"
			Width="36"
			Height="86"
			Background="Transparent"
			BorderThickness="0"
			VerticalAlignment="Top"
			HorizontalAlignment="Right"
			Padding="0"
			Classes="dotsMenuButton">
			<Button.Styles>
				<Style Selector="Button.dotsMenuButton">
					<Setter Property="Template">
						<ControlTemplate>
							<Canvas Width="36" Height="86">
								<Path x:Name="BgPath"
									  Width="36"
									  Height="86"
									  Data="M0 0 L0 50 L36 86 L36 0 Z"
									  Fill="Transparent"/>
								<Ellipse Canvas.Left="15.334" Canvas.Top="16"
										 Width="5.333" Height="5.333" Fill="Transparent"/>
								<Ellipse Canvas.Left="15.334" Canvas.Top="25.333"
										 Width="5.333" Height="5.333" Fill="Transparent"/>
								<Ellipse Canvas.Left="15.334" Canvas.Top="34.667"
										 Width="5.333" Height="5.333" Fill="Transparent"/>
							</Canvas>
						</ControlTemplate>
					</Setter>
				</Style>
				<Style Selector="Button.dotsMenuButton:pointerover /template/ Path#BgPath">
					<Setter Property="Fill" Value="#786DFF"/>
				</Style>
				<Style Selector="Button.dotsMenuButton:pointerover /template/ Ellipse">
					<Setter Property="Fill" Value="White"/>
				</Style>
				<Style Selector="Button.dotsMenuButton:pressed">
					<Setter Property="RenderTransform" Value="none"/>
				</Style>
				<Style Selector="Button.dotsMenuButton.open /template/ Path#BgPath">
					<Setter Property="Fill" Value="#786DFF"/>
				</Style>
				<Style Selector="Button.dotsMenuButton.open /template/ Ellipse">
					<Setter Property="Fill" Value="White"/>
				</Style>
			</Button.Styles>
		</Button>
	</Panel>
</UserControl>
