    <sys:String x:Key="ProfileView_Title">Профіль</sys:String>
    <sys:String x:Key="ProfileView_Joined_Format">Приєднався: {0}</sys:String>
    <!-- Explicit two-line break: on one line the label fills the whole 120px tab width
