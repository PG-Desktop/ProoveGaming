    <sys:String x:Key="ProfileView_Placeholder_Phone">Номер телефону</sys:String>
    <sys:String x:Key="ProfileView_Placeholder_Country">Країна</sys:String>
    <sys:String x:Key="ProfileView_EditNickname_Title">Нікнейм</sys:String>
    <sys:String x:Key="ProfileView_Security_ChangePassword">Змінити пароль</sys:String>
    <sys:String x:Key="ProfileView_Security_DeleteAccount">ВИДАЛИТИ АКАУНТ</sys:String>
    <sys:String x:Key="ProfileView_ChangePassword_Title">Зміна пароля</sys:String>
    <sys:String x:Key="ProfileView_ChangePassword_Subtitle">Ми надішлемо на пошту посилання для встановлення нового пароля. Підтвердьте адресу нижче, і ми його відправимо.</sys:String>
    <sys:String x:Key="ProfileView_ChangePassword_Send">НАДІСЛАТИ ПОСИЛАННЯ</sys:String>
    <sys:String x:Key="ProfileView_DeleteAccount_Title">Видалення акаунту</sys:String>
    <sys:String x:Key="ProfileView_DeleteAccount_Subtitle">Цю дію неможливо скасувати — профіль, аватар і всі дані буде видалено безповоротно. Введіть пароль для підтвердження.</sys:String>
    <sys:String x:Key="ProfileView_DeleteAccount_PasswordPlaceholder">Поточний пароль</sys:String>
    <sys:String x:Key="ProfileView_DeleteAccount_Confirm">ВИДАЛИТИ</sys:String>
    <sys:String x:Key="ProfileView_DeleteAccount_Error_InvalidPassword">Невірний пароль.</sys:String>
    <sys:String x:Key="ProfileView_DeleteAccount_Error_PasswordRequired">Введіть поточний пароль.</sys:String>
    <sys:String x:Key="ProfileView_DeleteAccount_Error_Generic">Не вдалося видалити акаунт. Спробуйте ще раз.</sys:String>
    <sys:String x:Key="ProfileView_EditNickname_Subtitle">Створіть власний нікнейм або оберіть один із рекомендованих Proove Gaming</sys:String>
    <sys:String x:Key="ProfileView_EditNickname_Placeholder">Нікнейм</sys:String>
    <sys:String x:Key="ProfileView_EditNickname_Recommended">Рекомендовані нікнейми</sys:String>
    <sys:String x:Key="ProfileView_EditNickname_Error_Generic">Не вдалося оновити нікнейм. Спробуйте ще раз.</sys:String>
    <sys:String x:Key="ProfileView_Notification_NicknameUpdated">Нікнейм успішно оновлено</sys:String>
    <sys:String x:Key="ProfileView_Notification_AvatarUpdated">Аватар успішно оновлено</sys:String>
    <sys:String x:Key="ProfileView_Notification_AvatarTooLarge">Зображення завелике. Максимальний розмір — 2 МБ.</sys:String>
    <sys:String x:Key="ProfileView_Notification_AvatarLoadFailed">Не вдалося завантажити вибране зображення.</sys:String>
    <sys:String x:Key="ProfileView_Notification_AvatarUploadFailed">Не вдалося завантажити аватар. Спробуйте ще раз.</sys:String>
    <sys:String x:Key="ProfileView_Notification_AvatarInvalidType">Формат зображення не підтримується.</sys:String>
    <sys:String x:Key="ProfileView_FilePicker_Title">Виберіть зображення аватара</sys:String>
    <sys:String x:Key="ProfileView_FilePicker_Images">Зображення</sys:String>
    <sys:String x:Key="ProfileView_EditEmail_Title">Змінити пошту</sys:String>
    <sys:String x:Key="ProfileView_EditEmail_Subtitle">Ваша пошта використовується для входу.
Введіть нову адресу, щоб оновити обліковий запис.</sys:String>
    <sys:String x:Key="ProfileView_EditEmail_Placeholder">Адреса електронної пошти</sys:String>
    <sys:String x:Key="ProfileView_Notification_EmailUpdated">Пошту успішно оновлено</sys:String>

