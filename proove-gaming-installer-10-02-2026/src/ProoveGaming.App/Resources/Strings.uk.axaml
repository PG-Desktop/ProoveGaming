<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Window_Title">Proove Gaming</sys:String>
    <sys:String x:Key="Header_Title">Ласкаво просимо до застосунку Proove Gaming</sys:String>

    <sys:String x:Key="WelcomeView_Title">PROOVE GAMING</sys:String>
    <sys:String x:Key="WelcomeView_Subtitle">Увійдіть або зареєструйтеся</sys:String>
    <sys:String x:Key="WelcomeView_SignIn">УВІЙТИ</sys:String>
    <sys:String x:Key="WelcomeView_SignUp">ЗАРЕЄСТРУВАТИСЯ</sys:String>
    <sys:String x:Key="WelcomeView_EmailLabel">Електронна пошта</sys:String>
    <sys:String x:Key="WelcomeView_PasswordLabel">Пароль</sys:String>
    <sys:String x:Key="WelcomeView_EmailPlaceholder">Введіть електронну пошту</sys:String>
    <sys:String x:Key="WelcomeView_PasswordPlaceholder">Введіть пароль</sys:String>
    <sys:String x:Key="WelcomeView_ForgotPassword">Забули пароль?</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Title">СКИДАННЯ ПАРОЛЯ</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Description">Введіть електронну адресу, з якою ви реєструвались. Ми надішлемо посилання для скидання пароля.</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Submit">НАДІСЛАТИ ПОСИЛАННЯ</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_BackToSignIn">ПОВЕРНУТИСЬ ДО ВХОДУ</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Error_NotFound">Обліковий запис із такою електронною адресою не знайдено.</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Error_Mail">Не вдалося надіслати листа. Спробуйте ще раз.</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Error_Generic">Щось пішло не так. Спробуйте ще раз.</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Sent_Title">Перевірте пошту</sys:String>
    <sys:String x:Key="WelcomeView_Forgot_Sent_Description">Ми надіслали посилання для скидання пароля на вашу пошту. Відкрийте пошту й перейдіть за посиланням, щоб задати новий пароль. Посилання діє 15 хвилин.</sys:String>
    <sys:String x:Key="WelcomeView_Notification_ResetLinkSent">Посилання для скидання пароля успішно надіслано</sys:String>
    <sys:String x:Key="WelcomeView_NoAccount">Немає облікового запису?</sys:String>
    <sys:String x:Key="WelcomeView_HasAccount">Вже є обліковий запис?</sys:String>
    <sys:String x:Key="WelcomeView_FirstNamePlaceholder">Ім'я</sys:String>
    <sys:String x:Key="WelcomeView_LastNamePlaceholder">Прізвище</sys:String>
    <sys:String x:Key="WelcomeView_TermsPrefix">Реєструючись, ви погоджуєтеся з </sys:String>
    <sys:String x:Key="WelcomeView_TermsLink">Умовами використання</sys:String>
    <sys:String x:Key="WelcomeView_TermsSuffix"> та </sys:String>
    <sys:String x:Key="WelcomeView_PrivacyLink">Політикою конфіденційності</sys:String>
    <sys:String x:Key="WelcomeView_AgreeTerms">Будь ласка, прийміть умови для продовження.</sys:String>
    <sys:String x:Key="WelcomeView_PasswordHint">Мінімум 8 символів: велика літера та цифра. Лише латиниця, без пробілів.</sys:String>
    <sys:String x:Key="WelcomeView_Attempts_Left">Невірна електронна пошта або пароль. Залишилось спроб: {0}.</sys:String>
    <sys:String x:Key="WelcomeView_Attempts_Locked">Забагато невірних спроб. Спробуйте знову через {0}:{1}</sys:String>
    <sys:String x:Key="WelcomeView_Error_EmailAlreadyExists">Ця електронна адреса вже зареєстрована. Спробуйте увійти.</sys:String>

    <!-- Spec error_code → user message -->
    <sys:String x:Key="Auth_Error_EmailRequired">Введіть електронну адресу.</sys:String>
    <sys:String x:Key="Auth_Error_InvalidEmail">Введіть коректну електронну адресу.</sys:String>
    <sys:String x:Key="Auth_Error_EmailAlreadyExists">Ця електронна адреса вже зареєстрована. Спробуйте увійти.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordRequired">Введіть пароль.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordTooShort">Пароль має містити щонайменше 8 символів.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordNoUppercase">Пароль має містити велику літеру.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordNoNumber">Пароль має містити цифру.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordHasSpaces">Пароль не може містити пробіли.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameRequired">Введіть нікнейм.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameTooShort">Нікнейм має містити щонайменше 3 символи.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameTooLong">Нікнейм може містити максимум 20 символів.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameHasSpaces">Нікнейм не може містити пробіли.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameInvalidCharacters">Дозволені лише латинські літери, цифри та підкреслення.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameAlreadyExists">Цей нікнейм вже зайнятий.</sys:String>
    <sys:String x:Key="Auth_Error_TermsRequired">Прийміть умови, щоб продовжити.</sys:String>

    <sys:String x:Key="AgreementTermsView_Title_PrivacyPolicy">Політика конфіденційності</sys:String>
    <sys:String x:Key="AgreementTermsView_Title_TermsOfService">Умови надання послуг</sys:String>
    <sys:String x:Key="AgreementTermsView_Title_LicenseAgreement">Ліцензійна угода</sys:String>

    <sys:String x:Key="ChooseNicknameView_Title">Введіть нікнейм</sys:String>
    <sys:String x:Key="ChooseNicknameView_Subtitle">Створіть власний нікнейм або оберіть один із рекомендованих Proove Gaming</sys:String>
    <sys:String x:Key="ChooseNicknameView_Placeholder">Нікнейм</sys:String>
    <sys:String x:Key="ChooseNicknameView_Or">Рекомендовані нікнейми</sys:String>
    <sys:String x:Key="ChooseNicknameView_Error_Nickname">Введіть нікнейм.</sys:String>
    <sys:String x:Key="ChooseNicknameView_Success_Nickname">Ви обрали чудовий нікнейм!</sys:String>

    <sys:String x:Key="Button_Cancel">СКАСУВАТИ</sys:String>
    <sys:String x:Key="Button_Confirm">ПІДТВЕРДИТИ</sys:String>

    <sys:String x:Key="HomeView_LogoutConfirm_Title">Вийти?</sys:String>
    <sys:String x:Key="HomeView_LogoutConfirm_Body">Ви вийдете з облікового запису на цьому пристрої.
Ви зможете увійти знову в будь-який час.</sys:String>
    <sys:String x:Key="HomeView_LogoutConfirm_Confirm">ВИЙТИ</sys:String>

    <sys:String x:Key="HomeView_Tab_Devices">ПРИСТРОЇ</sys:String>
    <sys:String x:Key="HomeView_Tab_Games">ІГРИ</sys:String>
    <sys:String x:Key="HomeView_Tab_Statistics">СТАТИСТИКА</sys:String>
    <sys:String x:Key="HomeView_ProfileMenu_Profile">Профіль</sys:String>
    <sys:String x:Key="HomeView_ProfileMenu_LogOut">Вийти</sys:String>
    <sys:String x:Key="HomeView_Menu_ContactUs">Зв'язатися з нами</sys:String>
    <sys:String x:Key="HomeView_Menu_Information">Інформація</sys:String>
    <sys:String x:Key="HomeView_GuestMenu_Title">Гостьовий режим</sys:String>
    <sys:String x:Key="HomeView_GuestMenu_SignUp">Зареєструватися</sys:String>
    <sys:String x:Key="HomeView_Greeting_Default">Привіт, гостю</sys:String>
    <sys:String x:Key="HomeView_Greeting_Format">Привіт, {0}</sys:String>
    <sys:String x:Key="HomeView_AddDeviceCard_Title">ПІДКЛЮЧІТЬ ПЕРШИЙ ДЕВАЙС</sys:String>
    <sys:String x:Key="HomeView_CardMenu_SwitchProfile">Змінити профіль</sys:String>
    <sys:String x:Key="HomeView_CardMenu_OpenSettings">Налаштування</sys:String>
    <sys:String x:Key="HomeView_CardMenu_Delete">Видалити</sys:String>
    <sys:String x:Key="DeviceType_WiredMouse">Дротова миша</sys:String>
    <sys:String x:Key="DeviceType_WirelessMouse">Бездротова миша</sys:String>
    <sys:String x:Key="DeviceType_WiredKeyboard">Дротова клавіатура</sys:String>
    <sys:String x:Key="DeviceType_WirelessKeyboard">Бездротова клавіатура</sys:String>
    <sys:String x:Key="DeviceType_WirelessHeadset">Бездротова гарнітура</sys:String>

    <sys:String x:Key="SettingsView_Title">Налаштування</sys:String>
