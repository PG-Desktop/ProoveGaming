    <!-- Device Details section headers -->
    <sys:String x:Key="DeviceDetails_Section_ButtonSettings">НАЛАШТУВАННЯ КНОПОК</sys:String>
    <sys:String x:Key="DeviceDetails_Section_KeyAssignment">ПРИЗНАЧЕННЯ КЛАВІШ</sys:String>
    <sys:String x:Key="DeviceDetails_Header_SelectMouseButton">Оберіть кнопку миші</sys:String>
    <sys:String x:Key="DeviceDetails_Header_KeyAssignment">Призначення клавіші</sys:String>
    <sys:String x:Key="DeviceDetails_KeyAssignment_ReadFailed">Не вдалося зчитати поточну розкладку з клавіатури. Нижче показано заводські значення, які можуть не збігатися з клавіатурою. Перепідключіть її та відкрийте цю сторінку знову.</sys:String>
    <sys:String x:Key="DeviceDetails_Macros_UploadFailed">Не вдалося записати бібліотеку макросів у клавіатуру, тому клавішу не прив'язано. Перепідключіть клавіатуру і спробуйте ще раз; якщо помилка повторюється — прошивка цієї клавіатури може не зберігати макроси.</sys:String>
    <sys:String x:Key="DeviceDetails_BluetoothMode_Title">РЕЖИМ BLUETOOTH</sys:String>
    <sys:String x:Key="DeviceDetails_BluetoothMode_Message">Налаштування пристрою недоступні під час підключення через Bluetooth. Підключіть пристрій через бездротовий адаптер або USB-кабель, щоб внести зміни.</sys:String>

