    <!-- Діалог підтвердження видалення пресета -->
    <!-- Delete Device confirmation dialog (home view card 3-dot menu -> Delete) -->
    <sys:String x:Key="DeleteDevice_Title">ВИДАЛИТИ ПРИСТРІЙ</sys:String>
    <sys:String x:Key="DeleteDevice_Body">Цей пристрій буде видалено зі списку. Ви зможете підключити його знову в будь-який час.</sys:String>
    <sys:String x:Key="DeleteDevice_Confirm">ВИДАЛИТИ</sys:String>

    <sys:String x:Key="DeletePreset_Title">Видалити пресет?</sys:String>
    <sys:String x:Key="DeletePreset_Body">Цей пресет і всі його збережені налаштування буде видалено назавжди.
Цю дію неможливо скасувати.</sys:String>
    <sys:String x:Key="DeletePreset_Confirm">ВИДАЛИТИ</sys:String>
    <sys:String x:Key="DeleteDpiPoint_Title">Видалити точку DPI?</sys:String>
    <sys:String x:Key="DeleteDpiPoint_Body">Ви впевнені, що хочете видалити цю точку DPI? Цю дію не можна скасувати.</sys:String>
    <sys:String x:Key="DeleteDpiPoint_Confirm">ВИДАЛИТИ</sys:String>

    <!-- Діалог підтвердження незбережених змін (при виході з DeviceDetails з незбереженим пресетом) -->
    <sys:String x:Key="UnsavedChanges_Title">Зберегти зміни поточного пресета?</sys:String>
    <sys:String x:Key="UnsavedChanges_Body">Налаштування пристрою було змінено.
