    <!-- API error surfacing (docs/plans/improve-api-error-surfacing) -->
    <sys:String x:Key="ContactUs_Error_RateLimited">Ви щойно надіслали повідомлення. Зачекайте близько хвилини, перш ніж надсилати наступне.</sys:String>
