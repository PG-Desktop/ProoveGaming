    <sys:String x:Key="Card_NoConnection">НЕ ПІДКЛЮЧЕНО</sys:String>

    <!-- Діалог підтвердження скидання пресета -->
    <sys:String x:Key="ResetPreset_Title">Скинути пресет?</sys:String>
    <sys:String x:Key="ResetPreset_Body">Усі зміни, внесені до поточного пресета, буде скасовано.
