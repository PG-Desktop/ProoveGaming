    <sys:String x:Key="DeleteDpiPoint_Confirm">DELETE</sys:String>

    <!-- Unsaved Changes confirmation dialog (shown when the user tries to leave DeviceDetails with a dirty preset) -->
    <sys:String x:Key="UnsavedChanges_Title">Save changes to the current preset?</sys:String>
    <sys:String x:Key="UnsavedChanges_Body">Current device settings have been modified.
Do you want to save the changes before leaving?</sys:String>
    <sys:String x:Key="UnsavedChanges_Body_Switching">Current device settings have been modified.
Do you want to save the changes before switching presets?</sys:String>
    <sys:String x:Key="UnsavedChanges_Discard">DON'T SAVE</sys:String>
    <sys:String x:Key="UnsavedChanges_Save">SAVE</sys:String>

    <!-- Auto-created preset name (created on device connect when the presets list is empty). -->
    <sys:String x:Key="Presets_DefaultName">Default</sys:String>

    <!-- DPI section -->
    <sys:String x:Key="DeviceDetails_Dpi_Title">DPI Settings</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Recommendations">RECOMMENDATIONS</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_PollingRate">Polling Rate</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_PollingRate_Subtitle">Higher values provide smoother cursor movement.</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_LiftOffDistance">Lift-off Distance</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_LiftOffDistance_Subtitle">Adjusts the height at which tracking stops when the mouse is lifted.</sys:String>
    <!-- No leading "+": the glyph is its own element in the view, aligned to the radio-circle
         column, so it cannot drift with a longer translation. -->
    <sys:String x:Key="DeviceDetails_Dpi_AddPoint">ADD POINT</sys:String>
    <!-- One string per point rather than a "{0}" ordinal built in code: the suffix is
         language-specific (st/nd/rd/th here, gender-agreeing endings in uk), and CLAUDE.md keeps
         that out of the view models. The set is bounded — both mice cap the stage table at 8 —
         and DeviceDetails_Dpi_PointFormat below is the fallback if a catalog ever declares more. -->
    <sys:String x:Key="DeviceDetails_Dpi_Point_1">1st point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Point_2">2nd point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Point_3">3rd point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Point_4">4th point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Point_5">5th point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Point_6">6th point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Point_7">7th point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_Point_8">8th point</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_PointFormat">Point {0}</sys:String>
    <sys:String x:Key="DeviceDetails_Dpi_StepFormat">Step: {0} dpi</sys:String>

