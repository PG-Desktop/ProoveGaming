    <!-- Spec error_code → user message -->
    <sys:String x:Key="Auth_Error_EmailRequired">Please enter your email address.</sys:String>
    <sys:String x:Key="Auth_Error_InvalidEmail">Please enter a valid email address.</sys:String>
    <sys:String x:Key="Auth_Error_EmailAlreadyExists">This email is already registered. Try signing in instead.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordRequired">Please enter a password.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordTooShort">Password must be at least 8 characters.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordNoUppercase">Password must include at least one uppercase letter.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordNoNumber">Password must include at least one number.</sys:String>
    <sys:String x:Key="Auth_Error_PasswordHasSpaces">Password cannot contain spaces.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameRequired">Please enter a nickname.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameTooShort">Nickname must be at least 3 characters.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameTooLong">Nickname must be 20 characters or fewer.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameHasSpaces">Nickname cannot contain spaces.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameInvalidCharacters">Use only Latin letters, numbers, and underscores.</sys:String>
    <sys:String x:Key="Auth_Error_NicknameAlreadyExists">This nickname is already taken.</sys:String>
    <sys:String x:Key="Auth_Error_TermsRequired">Please accept the terms to continue.</sys:String>
    <sys:String x:Key="WelcomeView_Error_SignIn">Incorrect email or password.</sys:String>
    <sys:String x:Key="WelcomeView_Error_Password">Password does not meet the requirements.</sys:String>
    <sys:String x:Key="WelcomeView_Error_Terms">Please accept the terms to continue.</sys:String>
    <sys:String x:Key="WelcomeView_PasswordHint">Must be at least 8 characters, include uppercase and number. Latin only, no spaces.</sys:String>
    <sys:String x:Key="WelcomeView_Attempts_Left">Incorrect email or password. You have {0} attempts left.</sys:String>
    <sys:String x:Key="WelcomeView_Attempts_Locked">Too many incorrect password attempts. Try again in {0}:{1}</sys:String>

