    <sys:String x:Key="ExtendedKeys_Socd_PriorityDescription">Choose which key triggers when both keys are pressed past their actuation point.</sys:String>
    <sys:String x:Key="ExtendedKeys_Socd_LastInput">Last Input Priority</sys:String>
    <sys:String x:Key="ExtendedKeys_Socd_LastInput_Tip">When both keys pass the actuation point, the last pressed key overrides the first.</sys:String>
