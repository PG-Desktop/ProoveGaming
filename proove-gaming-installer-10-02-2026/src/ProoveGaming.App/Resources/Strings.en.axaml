    <sys:String x:Key="Card_Connection_Bluetooth">Connected via Bluetooth</sys:String>
    <sys:String x:Key="Card_Connection_None">Not connected</sys:String>
    <sys:String x:Key="Card_Connection_BatteryLevel">Battery level {0}%</sys:String>

    <!-- Disconnected-card status label (uppercase per the design; the pixel font has no
         text transform, so the casing lives in the value). -->
    <sys:String x:Key="Card_NoConnection">NO CONNECTION</sys:String>

    <!-- Reset Preset confirmation dialog -->
    <sys:String x:Key="ResetPreset_Title">Reset Preset?</sys:String>
    <sys:String x:Key="ResetPreset_Body">All changes made to the current preset will be discarded.
Do you want to restore the default settings?</sys:String>
    <sys:String x:Key="ResetPreset_Confirm">RESET</sys:String>

    <!-- Delete Device confirmation dialog (home view card 3-dot menu -> Delete) -->
    <sys:String x:Key="DeleteDevice_Title">DELETE DEVICE</sys:String>
    <sys:String x:Key="DeleteDevice_Body">This device will be removed from your list. You can reconnect it anytime.</sys:String>
    <sys:String x:Key="DeleteDevice_Confirm">DELETE</sys:String>

    <!-- Delete Preset confirmation dialog -->
    <sys:String x:Key="DeletePreset_Title">Delete Preset?</sys:String>
    <sys:String x:Key="DeletePreset_Body">This preset and all of its saved settings will be permanently deleted.
This action cannot be undone.</sys:String>
    <sys:String x:Key="DeletePreset_Confirm">DELETE</sys:String>
    <sys:String x:Key="DeleteDpiPoint_Title">Delete DPI point?</sys:String>
