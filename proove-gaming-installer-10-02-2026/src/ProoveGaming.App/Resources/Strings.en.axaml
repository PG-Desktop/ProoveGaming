    <!-- Save Preset dialog -->
    <sys:String x:Key="SavePreset_Title">Save Preset</sys:String>
    <sys:String x:Key="SavePreset_Subtitle">Select a preset to overwrite with the current device settings.</sys:String>
    <sys:String x:Key="SavePreset_SearchPlaceholder">Search</sys:String>
    <sys:String x:Key="SavePreset_Confirm">SAVE</sys:String>

    <!-- Device card connection tooltip (hover over the card's connection indicator) -->
    <sys:String x:Key="Card_Connection_Cable">Connected via cable</sys:String>
