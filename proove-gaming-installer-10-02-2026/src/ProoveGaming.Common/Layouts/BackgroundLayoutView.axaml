<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="ProoveGaming.Common.Layouts.BackgroundLayoutView">
	<Grid>
		<Image x:Name="BackgroundImage"
			   Stretch="Fill"
			   Source="avares://ProoveGaming.Common/Assets/background.jpg" />

		<ContentPresenter x:Name="LayoutContentPresenter" />
	</Grid>
</UserControl>
