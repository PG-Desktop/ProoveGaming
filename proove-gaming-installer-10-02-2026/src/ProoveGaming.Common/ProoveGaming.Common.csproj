<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProoveGaming.Common</AssemblyName>
    <RootNamespace>ProoveGaming.Common</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
    <AvaloniaResource Include="Templates\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Styles\SharedActionButtonStyles.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProoveGaming.App.Tests" />
    <InternalsVisibleTo Include="ProoveGaming.Installer.Tests" />
  </ItemGroup>
</Project>
