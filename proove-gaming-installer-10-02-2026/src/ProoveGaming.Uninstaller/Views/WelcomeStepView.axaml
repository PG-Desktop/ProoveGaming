<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:commonLayouts="clr-namespace:ProoveGaming.Common.Layouts;assembly=ProoveGaming.Common"
			 x:Class="ProoveGaming.Uninstaller.Views.WelcomeStepView">
	<commonLayouts:StepFrameLayoutView>
		<commonLayouts:StepFrameLayoutView.StepContent>
			<Border VerticalAlignment="Center"
					Padding="0,0,0,0">
				<Grid Width="600"
					  HorizontalAlignment="Center"
					  RowDefinitions="Auto,Auto,Auto,Auto">
					<TextBlock Grid.Row="0"
							   Text="{DynamicResource Step1_Title}"
							   Classes="uninstallerStepTitle"
							   Foreground="White"
							   HorizontalAlignment="Center"
							   TextWrapping="Wrap" />

					<TextBlock Grid.Row="1"
							   Text="{DynamicResource Step1_Subtitle}"
							   Classes="uninstallerStepSubtitle"
							   Foreground="#D8D3FF"
							   TextWrapping="Wrap"
							   Margin="0,8,0,0"
							   MaxWidth="600" />

					<CheckBox x:Name="DeleteProfilesSettingsCheckBox"
							  Grid.Row="2"
							  Margin="0,32,0,32"
							  Classes="pgCheckbox pgOptionCheckBox uninstallerOptionCheckBox"
							  HorizontalAlignment="Center"
							  IsChecked="False"
							  Content="{DynamicResource Label_DeleteUserProfilesAndSettings}" />

					<Grid Grid.Row="3"
						  Margin="0"
						  Width="600"
						  HorizontalAlignment="Center"
						  ColumnDefinitions="*,*"
						  ColumnSpacing="16">
						<Button x:Name="CancelButton"
								Grid.Column="0"
								Content="{DynamicResource Button_Cancel}"
								HorizontalAlignment="Stretch"
								Classes="pgSecondaryActionButton" />

						<Button x:Name="UninstallButton"
								Grid.Column="1"
								Content="{DynamicResource Button_Uninstall}"
								HorizontalAlignment="Stretch"
								Classes="pgCancelActionButton" />
					</Grid>
				</Grid>
			</Border>
		</commonLayouts:StepFrameLayoutView.StepContent>
	</commonLayouts:StepFrameLayoutView>
</UserControl>
