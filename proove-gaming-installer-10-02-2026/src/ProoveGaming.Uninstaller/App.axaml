<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="ProoveGaming.Uninstaller.App"
			 RequestedThemeVariant="Default">
	<Application.Resources>
		<ResourceDictionary>
			<FontFamily x:Key="BaseAppFont">Segoe UI, Inter</FontFamily>
			<FontFamily x:Key="PixelFont">avares://ProoveGaming.Common/Assets/Fonts#Pixel Font7, Inter</FontFamily>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://ProoveGaming.Uninstaller/Resources/Strings.en.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme/>
		<StyleInclude Source="avares://ProoveGaming.Common/Styles/SharedCheckboxStyles.axaml" />
		<StyleInclude Source="avares://ProoveGaming.Common/Styles/SharedActionButtonStyles.axaml" />

		<Style Selector="TextBlock">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="LineHeight" Value="24" />
		</Style>

		<Style Selector="Button.uninstallerPrimaryButton">
			<Setter Property="Background" Value="#6357FF" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
			<Setter Property="FontWeight" Value="Light" />
			<Setter Property="FontStyle" Value="Normal" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="BorderBrush" Value="#6357FF" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.uninstallerPrimaryButton:pointerover">
			<Setter Property="Background" Value="#786DFF" />
			<Setter Property="BorderBrush" Value="#786DFF" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.uninstallerPrimaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#786DFF" />
			<Setter Property="BorderBrush" Value="#786DFF" />
			<Setter Property="Foreground" Value="White" />
		</Style>

		<Style Selector="Button.uninstallerActionButton">
			<Setter Property="Background" Value="#FF383C" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
			<Setter Property="FontWeight" Value="Light" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="16,17.5" />
			<Setter Property="Height" Value="56" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.uninstallerActionButton:pointerover">
			<Setter Property="Background" Value="#786DFF" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.uninstallerActionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#FF585C" />
			<Setter Property="Foreground" Value="White" />
		</Style>

		<Style Selector="Button.uninstallerSecondaryButton">
			<Setter Property="Background" Value="#1A6357FF" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
			<Setter Property="FontWeight" Value="Light" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="BorderBrush" Value="#6357FF" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="16,17.5" />
			<Setter Property="Height" Value="56" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.uninstallerSecondaryButton:pointerover">
			<Setter Property="Background" Value="#266357FF" />
			<Setter Property="BorderBrush" Value="#7A70FF" />
			<Setter Property="Foreground" Value="White" />
		</Style>
		<Style Selector="Button.uninstallerSecondaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#266357FF" />
			<Setter Property="BorderBrush" Value="#7A70FF" />
			<Setter Property="Foreground" Value="White" />
		</Style>

		<Style Selector="TextBlock.uninstallerStepTitle">
			<Setter Property="FontFamily" Value="{DynamicResource PixelFont}" />
			<Setter Property="FontSize" Value="36" />
			<Setter Property="FontWeight" Value="ExtraLight" />
			<Setter Property="LineHeight" Value="32" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>

		<Style Selector="TextBlock.uninstallerStepSubtitle">
			<Setter Property="Foreground" Value="#BEBCEA" />
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="LineHeight" Value="24" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>

		<Style Selector="CheckBox.uninstallerOptionCheckBox">
			<Setter Property="FontFamily" Value="{DynamicResource BaseAppFont}" />
			<Setter Property="Foreground" Value="#BEBCEA" />
			<Setter Property="Opacity" Value="0.7" />
		</Style>

		<Style Selector="CheckBox.uninstallerOptionCheckBox /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="#BEBCEA" />
		</Style>

		<Style Selector="CheckBox.uninstallerOptionCheckBox:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="#BEBCEA" />
		</Style>

		<Style Selector="CheckBox.uninstallerOptionCheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="#BEBCEA" />
		</Style>

		<Style Selector="Button.pgSecondaryActionButton">
			<Setter Property="Padding" Value="16,17.5" />
		</Style>
		<Style Selector="Button.pgCancelActionButton">
			<Setter Property="Padding" Value="16,17.5" />
		</Style>
	</Application.Styles>
</Application>
